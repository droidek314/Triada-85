; ============================================================================
;  SYSVARS.TASM -- the ROM's system variables and constants
;
;  RAM 0 ... 242 belongs to the ROM (SPEC 2.3). Programs may read these
;  variables (and include this file to get the names), but should not
;  write them, except AUTORUN, which is meant for the host (DECISIONS.md D-028).
;
;  This file only defines names; it produces no words.
; ============================================================================

; --- system variables (RAM) -------------------------------------------------
AUTORUN     = 0         ; address of a program to start after boot; 0 = none.
                        ; The HOST sets it (e.g. "triada run prog.tri") before
                        ; the CPU starts; the ROM clears it and runs the program
                        ; as if RUN had been typed.
CURSOR_X    = 1         ; text cursor column, 0 ... 26 (27 = "line full, wrap on
                        ; the next character")
CURSOR_Y    = 2         ; text cursor row, 0 ... 17
RUN_DONE    = 3         ; how many programs started by RUN or AUTORUN have
                        ; returned (RET) to the monitor; the headless runner
                        ; watches it to know a program has finished
LINEBUF     = 162       ; input line of the monitor and TRIBASIC, up to 81 words
                        ; (162 ... 242)

; --- TRIBASIC's variables (M14) ----------------------------------------------
B_PROGEND   = 4         ; address of the program's end marker (a 0 word)
B_VAREND    = 5         ; first free word after the variables
B_CSP       = 6         ; next free word of the FOR/GOSUB control stack
B_LINE      = 7         ; number of the line being run (0 = direct mode)
B_LINEPTR   = 8         ; address of that line's record (0 = direct mode)
B_RUNNING   = 9         ; 1 while a program runs
B_ERRSP     = 10        ; the statement loop's SP: errors and jumps reset it
B_KEYN      = 11        ; keys waiting in B_KEYS
B_KEYS      = 12        ; ... 27: keys read while checking for Esc
B_IDENT     = 28        ; ... 38: a word being looked up (9 chars, '(' + 0)
B_TYPE      = 39        ; the type of the last value: 0 = number, 1 = string (M15)
B_TMP       = 40        ; the next free string temp
B_FONTFG    = 41        ; the font's colours now (COLOR)
B_FONTBG    = 42
B_ARGS      = 43        ; ... 52: the numbers of a machine statement
LINE_MAX    = 24        ; longest command line: 27 columns minus "> " minus cursor

; --- constants --------------------------------------------------------------
COLS        = 27        ; text columns = tile map columns
ROWS        = 18        ; text rows
MAP_CELLS   = 486       ; 27 x 18
TEXT_FG     = 4         ; light cyan, trits 0++  (R 128, G 255, B 255)
TEXT_BG     = -12       ; dark blue,  trits --0  (R 0, G 0, B 128)
FRAME_COLOUR = -11      ; blue border, trits --+
STACK_TOP   = 59049     ; SP after boot: the stack grows down from the top of RAM
PROGRAM_START = 243     ; where programs load, and the default of RUN
FREE_WORDS  = 39757     ; 243 ... 39,999: shown on the boot screen
BASIC_COLD  = -59048    ; TRIBASIC's entry points in the extension ROM (SPEC 2.5)
BASIC_WARM  = -59046
