; ============================================================================
;  BASIC.TASM -- TRIBASIC, the TRIADA-85's built-in language (M14-M15, SPEC 10)
;
;     TRIBASIC V1.0
;     39757 WORDS FREE
;     READY.
;     10 ASK "IS IT RAINING"; R
;     20 IF R THEN PRINT "UMBRELLA" MAYBE PRINT "JUST IN CASE" ELSE PRINT "SUN"
;     RUN
;
;  It lives in the extension ROM (SPEC 2.5) but is assembled together with
;  the main ROM, so it calls the kernel's and the monitor's own routines
;  (putchar, print, printnum, celladdr, runprog, monitor) directly.
;
;  Memory (SPEC 2.5):
;     243 ...        the program: one record per line, in line-number order:
;                      [length][line number][text ...][0]
;                    then a single 0 word, the end marker (B_PROGEND)
;     ... B_VAREND   the variables and arrays, one entry each:
;                      [length][name: 10 words, 0-padded][data ...]
;                    a number: 1 word; a string: a SLOT; an array: [low][high]
;                    and its elements (1 word or a SLOT each)
;     40,000 ...     tiles, map, sprites (not TRIBASIC's)
;     45,000 ...     the control stack: FOR and GOSUB frames, growing up
;     50,000 ...     INBUF, the line INPUT reads; FNAME, a file name
;     50,100 ...     string temps: SLOTs for the values a statement works out,
;                    all freed when the next statement starts
;  A string is a SLOT: [length][up to 80 characters], one per word. Every
;  string variable owns its own SLOT, so nothing ever needs tidying up (no
;  "garbage collection"); M15, D-051.
;  Keywords are stored as tokens: one negative word each, -1 for PRINT ...
;  -68 for TERN$, then the modem's -69 DIAL ... -74 MRECV$ (M17), in the
;  order of kwtab below. Text is 32 ... 126.
;  Every expression has a type, kept in B_TYPE: 0 = a number (R0 is its
;  value), 1 = a string (R0 is the address of its SLOT).
;
;  Registers: R7 is the position in the line being run or parsed, everywhere.
;  The other registers are scratch: a routine keeps what it needs across a
;  call on the stack. The statement loop runs with SP = B_ERRSP, so an error,
;  a GOTO or a jump back into a loop simply resets SP there.
; ============================================================================

B_MEMTOP    = TILES     ; program + variables stay below the tile patterns
CSTACK      = 45000     ; the control stack's bottom ...
CSTACK_END  = 49990     ; ... and its limit
INBUF       = 50000     ; INPUT's line (up to 81 words)
FNAME       = 50082     ; a file name being built (up to 18 words)
TEMP_START  = 50100     ; string temps ...
TEMP_END    = 57900     ; ... up to here (the CPU stack is far above)
SLOT        = 81        ; a string: its length and up to 80 characters
NAMELEN     = 10        ; a variable's name: up to 9 characters and '(' for arrays
VARHEAD     = 11        ; an entry's length word and name
LINE_LEN    = 80        ; the longest line that can be typed
F_GOSUB     = 1         ; the kind of a control stack frame (its top word)
F_FOR       = 2

; tokens the interpreter tests for (their place in kwtab, negated)
T_TO        = -9
T_STEP      = -10
T_IF        = -12
T_THEN      = -13
T_MAYBE     = -14
T_ELSE      = -15
T_REM       = -16
T_AND       = -27
T_OR        = -28
T_NOT       = -29
T_MOD       = -30
T_TRUE      = -31
T_FALSE     = -32
T_UNKNOWN   = -33
T_FIRSTFN   = -51       ; ABS: the first function (-51 ... -68, then -73, -74)

        .org EXT_ROM_START              ; the first extension ROM word (-59,048)

; --- entry points: fixed addresses (SPEC 2.5) --------------------------------
        JMP b_cold                      ; -59,048  BASIC_COLD: clear the program, start
        JMP b_warm                      ; -59,046  BASIC_WARM: start, keep the program

; ===========================================================================
; Starting, READY. and the main loop
; ===========================================================================

b_cold: LDI SP, STACK_TOP
        JSR b_fontcolours
        JSR b_new
        JSR b_hello
        JMP b_ready

; b_hello: the second and third lines of the boot screen. A new machine has
; no program, so the free words are always FREE_WORDS here.
b_hello: LDI R0, msg_tribasic
        JSR print
        LDI R0, FREE_WORDS
        JSR printnum
        LDI R0, wordsfree
        JMP print

; b_fontcolours: the colours the kernel drew the font in (for COLOR).
b_fontcolours: LDI R0, TEXT_FG
        LDI R2, B_FONTFG
        ST R0, [R2]
        LDI R0, TEXT_BG
        LDI R2, B_FONTBG
        ST R0, [R2]
        RET

; Back from the monitor (its BASIC command): keep the program if it still is
; one -- the monitor may have POKEd anything into that memory.
b_warm: LDI SP, STACK_TOP
        JSR b_relink
        JSR b_clearvars
        JMP b_ready

; After a program the host started (AUTORUN) has returned: it may have used
; the program area, so TRIBASIC starts with an empty program. runprog has
; already printed READY.
b_afterprog: LDI SP, STACK_TOP
        JSR b_fontcolours
        JSR b_new
        JMP b_main

; READY., then read lines for ever. A numbered line is stored; anything else
; runs at once ("direct mode").
b_ready: LDI SP, STACK_TOP
        LDI R1, CSTACK
        LDI R2, B_CSP
        ST R1, [R2]
        JSR b_freshline                 ; READY. always starts a line
        LDI R0, ready                   ; the monitor's "READY.\n"
        JSR print
b_main: LDI R1, B_ERRSP
        ST SP, [R1]                     ; errors come back to this stack depth
        LDI R0, 0
        LDI R1, B_RUNNING
        ST R0, [R1]
        LDI R1, B_LINE
        ST R0, [R1]
        LDI R1, B_LINEPTR
        ST R0, [R1]
        LDI R0, LINEBUF
        LDI R1, 0                       ; Esc does nothing here
        JSR b_readline
        LDI R7, LINEBUF
        JSR b_skip
        JZ b_main                       ; an empty line
        JSR b_isdigit
        MOV R1, R1
        JZ bm_direct
        JSR b_store                     ; a program line
        JMP b_main
bm_direct: JSR b_tokenize
        JMP b_stmt

; ===========================================================================
; Running statements
; ===========================================================================

; b_stmt: runs the statement at R7. Every statement first checks for Esc and
; frees the string temps of the one before.
b_stmt: JSR b_poll
        LDI R1, TEMP_START
        LDI R2, B_TMP
        ST R1, [R2]
        JSR b_skip
        JZ b_eol
        LDI R2, ':'
        CMP R0, R2
        JZ bs_colon
        MOV R0, R0
        JN bs_token                     ; keywords are negative
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        JSR st_letvar                   ; "A = 5" is a LET without the word
        JMP b_after
bs_colon: INC R7
        JMP b_stmt
bs_token: LDI R2, T_MAYBE               ; reaching MAYBE or ELSE ends an IF's branch
        CMP R0, R2
        JZ b_eol
        LDI R2, T_ELSE
        CMP R0, R2
        JZ b_eol
        INC R7                          ; past the keyword
        NEG R0                          ; -1 ... -68 -> 1 ... 68
        LDI R2, sttab - 1
        ADD R0, R2
        LD R0, [R0]                     ; the statement's routine, or 0
        JZ err_syntax
        LDI R1, b_after                 ; JSR to an address in R0: push the
        PUSH R1                         ; return address, push the target,
        PUSH R0                         ; RET (SPEC 3.10)
        RET

; b_after: a statement has ended; what comes next must be ':', the end of
; the line, or the MAYBE / ELSE that ends an IF's branch.
b_after: JSR b_skip
        JZ b_eol
        LDI R2, ':'
        CMP R0, R2
        JZ bs_colon
        LDI R2, T_MAYBE
        CMP R0, R2
        JZ b_eol
        LDI R2, T_ELSE
        CMP R0, R2
        JZ b_eol
        JMP err_syntax

; b_eol: the end of a line. Direct mode is done; a program goes on with the
; next line.
b_eol:  LDI R2, B_RUNNING
        LD R0, [R2]
        JZ b_ready
        LDI R2, B_LINEPTR
        LD R1, [R2]
        LD R0, [R1]                     ; this line's length
        ADD R1, R0                      ; = the next line's record

; b_goline: R1 = a line record. Runs the program from there (the end marker
; means the program has ended).
b_goline: LD R0, [R1]
        JZ b_ready
        LDI R2, B_LINEPTR
        ST R1, [R2]
        LD R0, [R1+1]
        LDI R2, B_LINE
        ST R0, [R2]
        LDI R0, 1
        LDI R2, B_RUNNING
        ST R0, [R2]
        MOV R7, R1
        ADDI R7, 2

; b_resume: goes on at R7 (B_LINEPTR, B_LINE and B_RUNNING already set).
b_resume: LDI R2, B_ERRSP
        LD SP, [R2]
        JMP b_stmt

; b_comeback: R1 = a line record, or 0 for the direct line; R7 = a place in
; it. B_LINE is already set. Used by RETURN and NEXT.
b_comeback: LDI R2, B_LINEPTR
        ST R1, [R2]
        LDI R0, 0
        MOV R1, R1
        JZ bcb_mode
        LDI R0, 1
bcb_mode: LDI R2, B_RUNNING
        ST R0, [R2]
        JMP b_resume

; ===========================================================================
; Errors and BREAK
; ===========================================================================

err_syntax: LDI R0, 1
        JMP b_error
err_undef: LDI R0, 2
        JMP b_error
err_return: LDI R0, 3
        JMP b_error
err_next: LDI R0, 4
        JMP b_error
err_memory: LDI R0, 5
        JMP b_error
err_div0: LDI R0, 6
        JMP b_error
err_overflow: LDI R0, 7
        JMP b_error
err_type: LDI R0, 8
        JMP b_error
err_subscript: LDI R0, 9
        JMP b_error
err_toolong: LDI R0, 10
        JMP b_error
err_notfound: LDI R0, 11
        JMP b_error
err_disk: LDI R0, 12

; b_error: R0 = error number (errtab). Prints "?MESSAGE ERROR IN line" (no
; "IN" in direct mode) and goes back to READY.
b_error: LDI R1, B_ERRSP
        LD SP, [R1]
        MOV R3, R0
        JSR b_freshline
        LDI R0, '?'
        JSR putchar
        LDI R1, errtab - 1
        ADD R1, R3
        LD R0, [R1]
        JSR print
        LDI R0, msg_error
        JSR print
        JSR b_inline
        LDI R0, 10
        JSR putchar
        JMP b_ready

; b_break: Esc or STOP: "BREAK IN line".
b_break: LDI R1, B_ERRSP
        LD SP, [R1]
        LDI R0, 0
        LDI R1, B_KEYN                  ; keys typed before the Esc are dropped
        ST R0, [R1]
        JSR b_freshline
        LDI R0, msg_break
        JSR print
        JSR b_inline
        LDI R0, 10
        JSR putchar
        JMP b_ready

; b_inline: " IN 120" while a program runs; nothing in direct mode.
b_inline: LDI R2, B_RUNNING
        LD R0, [R2]
        JZ bin_ret
        LDI R0, msg_in
        JSR print
        LDI R2, B_LINE
        LD R0, [R2]
        JMP printnum
bin_ret: RET

; b_freshline: a new line, unless the cursor already is at the start of one.
b_freshline: LDI R2, CURSOR_X
        LD R0, [R2]
        JZ bfr_ret
        LDI R0, 10
        JMP putchar
bfr_ret: RET

; ===========================================================================
; The keyboard: keys arriving while a program runs wait in B_KEYS
; ===========================================================================

; b_poll: takes the waiting keys from KEY. Esc is BREAK; the others wait in
; B_KEYS (16 at most) for INPUT, ASK or the next line. When B_KEYS is full,
; the rest stay in the keyboard queue, so typing ahead loses nothing (M15).
; Changes R0 ... R2.
b_poll: LDI R2, B_KEYN
        LD R1, [R2]
        LDI R2, 16
        CMP R1, R2
        JGE bp_ret                      ; full: leave the keys in the queue
        LDI R2, IO_BASE
        LD R0, [R2+KEY]
        JZ bp_ret
        LDI R2, 27
        CMP R0, R2
        JZ b_break
        LDI R2, B_KEYS
        ADD R2, R1
        ST R0, [R2]
        INC R1
        LDI R2, B_KEYN
        ST R1, [R2]
        JMP b_poll
bp_ret: RET

; b_key: the next key, from B_KEYS first, then from KEY; 0 if none.
; S is set from R0. Changes R0 ... R2.
b_key:  LDI R2, B_KEYN
        LD R1, [R2]
        JZ bk_io
        DEC R1
        ST R1, [R2]
        LDI R2, B_KEYS
        LD R0, [R2]
        PUSH R0
bk_shift: MOV R1, R1                    ; move the others down by one
        JZ bk_done
        LD R0, [R2+1]
        ST R0, [R2]
        INC R2
        DEC R1
        JMP bk_shift
bk_done: POP R0
        RET
bk_io:  LDI R1, IO_BASE
        LD R0, [R1+KEY]
        RET

; b_readline: R0 = buffer, R1 = 1 if Esc may end it. Reads up to 80
; characters (they may run over several screen rows) with echo, a blinking
; cursor and Backspace, until Enter. R0 = 0 after Enter, 1 after Esc; S is
; set from R0. Keeps R3 ... R8.
b_readline: PUSH R3
        PUSH R4
        PUSH R5
        MOV R4, R0                      ; the buffer
        MOV R5, R1                      ; may Esc end it?
        LDI R3, 0                       ; characters so far
brd_wait: LDI R1, IO_BASE               ; the cursor blinks every 27 frames
        LD R0, [R1+FRAME]
        SHT R0, -3
        LDI R2, 2
        MOD R0, R2
        JSR celladdr
        LDI R2, '_'
        MOV R0, R0
        JNZ brd_show
        LDI R2, ' '
brd_show: ST R2, [R1]
        JSR b_key
        JNZ brd_got
        WAIT
        JMP brd_wait
brd_got: PUSH R0
        JSR celladdr                    ; take the cursor away first
        LDI R2, ' '
        ST R2, [R1]
        POP R0
        LDI R2, 10
        CMP R0, R2
        JZ brd_enter
        LDI R2, 8
        CMP R0, R2
        JZ brd_back
        LDI R2, 27
        CMP R0, R2
        JZ brd_esc
        LDI R2, ' '                     ; only printable characters
        CMP R0, R2
        JN brd_wait
        LDI R2, 126
        CMP R0, R2
        JP brd_wait
        LDI R2, LINE_LEN
        CMP R3, R2
        JGE brd_wait                    ; the line is full
        MOV R2, R4
        ADD R2, R3
        ST R0, [R2]
        INC R3
        JSR putchar                     ; echo (keeps R3 ... R5)
        JMP brd_wait
brd_back: MOV R3, R3
        JZ brd_wait                     ; nothing to delete
        LDI R2, CURSOR_X
        LD R0, [R2]
        JNZ brd_bs
        LDI R2, CURSOR_Y                ; at column 0: the character is at the
        LD R0, [R2]                     ; end of the row above
        JZ brd_wait                     ; (that row has scrolled away)
        DEC R0
        ST R0, [R2]
        LDI R0, COLS
        LDI R2, CURSOR_X
        ST R0, [R2]
brd_bs: DEC R3
        LDI R0, 8
        JSR putchar
        JMP brd_wait
brd_esc: MOV R5, R5
        JZ brd_wait
        LDI R0, 1
        JMP brd_ret
brd_enter: MOV R2, R4
        ADD R2, R3
        LDI R0, 0
        ST R0, [R2]                     ; the end of the line
        LDI R0, 10
        JSR putchar
        LDI R0, 0
brd_ret: POP R5
        POP R4
        POP R3
        MOV R0, R0
        RET

; ===========================================================================
; Small helpers for reading text at R7
; ===========================================================================

; b_skip: moves R7 past spaces. R0 = the character there, S set from it.
b_skip: LD R0, [R7]
        LDI R2, ' '
        CMP R0, R2
        JNZ bsk_ret
        INC R7
        JMP b_skip
bsk_ret: MOV R0, R0
        RET

; b_isletter / b_isdigit: R1 = 1 if R0 is A ... Z / 0 ... 9, else 0. Keep R0.
b_isletter: LDI R1, 0
        LDI R2, 'A'
        CMP R0, R2
        JN bil_ret
        LDI R2, 'Z'
        CMP R0, R2
        JP bil_ret
        LDI R1, 1
bil_ret: RET

b_isdigit: LDI R1, 0
        LDI R2, '0'
        CMP R0, R2
        JN bid_ret
        LDI R2, '9'
        CMP R0, R2
        JP bid_ret
        LDI R1, 1
bid_ret: RET

; b_upper: a ... z in R0 become A ... Z. Changes R2.
b_upper: LDI R2, 'a'
        CMP R0, R2
        JN bup_ret
        LDI R2, 'z'
        CMP R0, R2
        JP bup_ret
        ADDI R0, -32
bup_ret: RET

; b_scanword: R1 = the address of a word's first letter. Copies the word
; (letters and digits, and a '$' that ends it) in upper case into B_IDENT,
; at most 9 characters, 0-terminated. R0 = the word's full length.
; Keeps R3 ... R8.
b_scanword: PUSH R3
        PUSH R4
        MOV R3, R1                      ; where to read
        LDI R4, 0                       ; the length so far
bsw_loop: LD R0, [R3]
        JSR b_upper
        JSR b_isletter
        MOV R1, R1
        JNZ bsw_take
        JSR b_isdigit
        MOV R1, R1
        JNZ bsw_take
        LDI R2, '$'
        CMP R0, R2
        JNZ bsw_end
        JSR bsw_put                     ; '$' is the last character of a word
        INC R4
        JMP bsw_end
bsw_take: JSR bsw_put
        INC R4
        INC R3
        JMP bsw_loop
bsw_end: MOV R0, R4                     ; the terminating 0 goes after
        LDI R2, 9                       ; min(length, 9) characters
        CMP R0, R2
        JLE bsw_term
        MOV R0, R2
bsw_term: LDI R2, B_IDENT
        ADD R2, R0
        LDI R1, 0
        ST R1, [R2]
        MOV R0, R4
        POP R4
        POP R3
        RET
bsw_put: LDI R2, 9                      ; character R0 goes to B_IDENT[R4], if it fits
        CMP R4, R2
        JGE bsp_ret
        LDI R2, B_IDENT
        ADD R2, R4
        ST R0, [R2]
bsp_ret: RET

; b_keyword: R0 = the token of the keyword in B_IDENT (-1 ... -68), or 0
; if the word isn't one. Keeps R3 ... R8.
b_keyword: PUSH R3
        PUSH R4
        PUSH R5
        LDI R3, kwtab
        LDI R4, -1                      ; the token of kwtab's current entry
bkw_next: LD R1, [R3]
        JZ bkw_none
        LDI R2, B_IDENT
bkw_cmp: LD R0, [R1]
        LD R5, [R2]
        CMP R0, R5
        JNZ bkw_skip
        MOV R0, R0
        JZ bkw_found                    ; both ended together: the same word
        INC R1
        INC R2
        JMP bkw_cmp
bkw_skip: INC R3
        DEC R4
        JMP bkw_next
bkw_found: MOV R0, R4
        JMP bkw_ret
bkw_none: LDI R0, 0
bkw_ret: POP R5
        POP R4
        POP R3
        MOV R0, R0
        RET

; b_linenum: reads a line number (decimal digits) at R7. R0 = the number;
; R1 = 1 if it is 1 ... 65,535, else 0 (S set from R1). Moves R7 past it.
b_linenum: PUSH R3
        LDI R0, 0
        LDI R1, 1
bln_loop: LD R3, [R7]
        ADDI R3, -48
        JN bln_end
        LDI R2, 9
        CMP R3, R2
        JP bln_end
        INC R7
        LDI R2, 6554                    ; already too big: just skip the digits
        CMP R0, R2
        JGE bln_big
        LDI R2, 10
        MUL R0, R2
        ADD R0, R3
        JMP bln_loop
bln_big: LDI R1, 0
        JMP bln_loop
bln_end: LDI R2, 65535
        CMP R0, R2
        JP bln_bad
        MOV R0, R0
        JP bln_ret
bln_bad: LDI R1, 0
bln_ret: POP R3
        MOV R1, R1
        RET

; b_number: reads a number at R7: decimal digits, or 0T and trits (0t too).
; R0 = its value and R1 = 1; R1 = 0 if it doesn't fit in a word; R1 = -1 for
; "0T" without trits. S is set from R1. Moves R7 past it.
b_number: PUSH R3
        LD R0, [R7]
        LDI R2, '0'
        CMP R0, R2
        JNZ bnu_dec
        LD R0, [R7+1]
        LDI R2, 'T'
        CMP R0, R2
        JZ bnu_tern
        LDI R2, 't'
        CMP R0, R2
        JZ bnu_tern
bnu_dec: LDI R0, 0
        LDI R1, 1
bnu_dloop: LD R3, [R7]
        ADDI R3, -48
        JN bnu_ret
        LDI R2, 9
        CMP R3, R2
        JP bnu_ret
        INC R7
        LDI R2, 26572                   ; would value * 10 + digit pass 265,720?
        CMP R0, R2
        JN bnu_ok
        JP bnu_big
        MOV R3, R3                      ; exactly 26,572: only a 0 still fits
        JNZ bnu_big
bnu_ok: LDI R2, 10
        MUL R0, R2
        ADD R0, R3
        JMP bnu_dloop
bnu_big: LDI R1, 0
        JMP bnu_dloop
bnu_tern: PUSH R4
        ADDI R7, 2                      ; past "0T"
        LDI R0, 0
        LDI R1, 1
        LDI R3, 0                       ; trits so far
bnt_loop: LD R4, [R7]
        LDI R2, '+'
        CMP R4, R2
        JZ bnt_plus
        LDI R2, '-'
        CMP R4, R2
        JZ bnt_minus
        LDI R2, '0'
        CMP R4, R2
        JNZ bnt_end
        LDI R4, 0
        JMP bnt_add
bnt_plus: LDI R4, 1
        JMP bnt_add
bnt_minus: LDI R4, -1
bnt_add: INC R7
        INC R3
        LDI R2, 12
        CMP R3, R2
        JP bnt_big                      ; a word has 12 trits
        SHT R0, 1                       ; one trit up (x 3) ...
        ADD R0, R4                      ; ... and the new trit
        JMP bnt_loop
bnt_big: LDI R1, 0
        JMP bnt_loop
bnt_end: MOV R3, R3
        JNZ bnt_ok
        LDI R1, -1                      ; "0T" and no trits
bnt_ok: POP R4
bnu_ret: POP R3
        MOV R1, R1
        RET

; b_strlit: R7 is at a '"': prints the text up to the closing '"' (or the end
; of the line) and moves R7 past it.
b_strlit: INC R7
bsl_loop: LD R0, [R7]
        JZ bsl_ret
        INC R7
        LDI R2, '"'
        CMP R0, R2
        JZ bsl_ret
        JSR putchar
        JMP bsl_loop
bsl_ret: RET

; ===========================================================================
; Entering lines: tokenizing, storing, deleting
; ===========================================================================

; b_tokenize: turns the line at R7 (0-terminated) into tokens, in place.
; Keywords become one negative word each, other words are made upper case,
; "0t" becomes "0T", and text in "quotes" and after REM is kept exactly.
; A keyword is always a whole word, so FORM is a name, not FOR M; and a
; token is shorter than its keyword, so writing never overtakes reading.
; Keeps R7.
b_tokenize: PUSH R7
        MOV R5, R7                      ; read
        MOV R6, R7                      ; write
btk_loop: LD R0, [R5]
        JZ btk_end
        LDI R2, '"'
        CMP R0, R2
        JZ btk_quote
        JSR b_upper
        JSR b_isletter
        MOV R1, R1
        JNZ btk_word
        LDI R2, '0'
        CMP R0, R2
        JNZ btk_copy
        LD R1, [R5+1]                   ; "0T" or "0t": a ternary number
        LDI R2, 't'
        CMP R1, R2
        JNZ btk_copy
        ST R0, [R6]
        LDI R0, 'T'
        ST R0, [R6+1]
        ADDI R5, 2
        ADDI R6, 2
        JMP btk_loop
btk_copy: ST R0, [R6]
        INC R5
        INC R6
        JMP btk_loop
btk_quote: ST R0, [R6]                  ; copy up to and with the closing quote
        INC R5
        INC R6
btq_loop: LD R0, [R5]
        JZ btk_end
        ST R0, [R6]
        INC R5
        INC R6
        LDI R2, '"'
        CMP R0, R2
        JNZ btq_loop
        JMP btk_loop
btk_word: MOV R1, R5
        JSR b_scanword                  ; R0 = length, B_IDENT = the word
        MOV R4, R0
        LDI R2, 7                       ; no keyword is longer than 7
        CMP R4, R2
        JP btk_name
        JSR b_keyword
        JZ btk_name
        ST R0, [R6]                     ; the token
        INC R6
        ADD R5, R4
        LDI R2, T_REM
        CMP R0, R2
        JNZ btk_loop
btk_rest: LD R0, [R5]                   ; after REM: everything as it is
        JZ btk_end
        ST R0, [R6]
        INC R5
        INC R6
        JMP btk_rest
btk_name: LD R0, [R5]                   ; a name: copied in upper case
        JSR b_upper
        ST R0, [R6]
        INC R5
        INC R6
        DEC R4
        JNZ btk_name
        JMP btk_loop
btk_end: LDI R0, 0
        ST R0, [R6]
        POP R7
        RET

; b_store: R7 is at a line number in LINEBUF. Stores the line, replacing one
; with the same number; a number with nothing after it deletes that line.
; Editing clears the variables (they are stored right after the program).
b_store: JSR b_linenum
        JZ err_syntax
        PUSH R0                         ; the line number
        JSR b_tokenize
        LDI R3, 0                       ; R3 = text length with its 0
        LDI R4, 0                       ; R4 = 1 if there is more than spaces
bst_len: MOV R1, R7
        ADD R1, R3
        LD R0, [R1]
        INC R3
        MOV R0, R0
        JZ bst_counted
        LDI R2, ' '
        CMP R0, R2
        JZ bst_len
        LDI R4, 1
        JMP bst_len
bst_counted: POP R5                     ; R5 = the line number
        LDI R6, PROGRAM_START           ; R6 = the first record numbered >= R5
bst_find: LD R0, [R6]
        JZ bst_here
        LD R1, [R6+1]
        CMP R1, R5
        JGE bst_here
        ADD R6, R0
        JMP bst_find
bst_here: LD R0, [R6]
        JZ bst_insert
        LD R1, [R6+1]
        CMP R1, R5
        JNZ bst_insert
        JSR b_delrec                    ; the old line goes
bst_insert: MOV R4, R4
        JZ bst_done                     ; only a number: it was a delete
        MOV R1, R3
        ADDI R1, 2                      ; R1 = the record's length
        LDI R2, B_PROGEND
        LD R0, [R2]
        ADD R0, R1                      ; where the end marker will be
        LDI R2, B_MEMTOP
        CMP R0, R2
        JGE err_memory
        LDI R2, B_PROGEND
        LD R0, [R2]                     ; move R6 ... PROGEND up by R1, top first
bst_move: LD R4, [R0]
        MOV R2, R0
        ADD R2, R1
        ST R4, [R2]
        CMP R0, R6
        JZ bst_moved
        DEC R0
        JMP bst_move
bst_moved: LDI R2, B_PROGEND
        LD R0, [R2]
        ADD R0, R1
        ST R0, [R2]
        ST R1, [R6]                     ; the new record: length, number ...
        ST R5, [R6+1]
        MOV R1, R6
        ADDI R1, 2
bst_copy: LD R0, [R7]                   ; ... and the text with its 0
        ST R0, [R1]
        INC R7
        INC R1
        DEC R3
        JNZ bst_copy
bst_done: JMP b_clearvars

; b_delrec: removes the line record at R6. Keeps R3 ... R8.
b_delrec: PUSH R3
        LD R1, [R6]                     ; its length
        LDI R2, B_PROGEND
        LD R3, [R2]
        SUB R3, R1                      ; the end marker's new place
        ST R3, [R2]
        MOV R0, R6
bdr_loop: MOV R2, R0
        ADD R2, R1
        LD R2, [R2]
        ST R2, [R0]
        CMP R0, R3
        JZ bdr_ret
        INC R0
        JMP bdr_loop
bdr_ret: POP R3
        RET

; b_new: no program, no variables.
b_new:  LDI R1, PROGRAM_START
        LDI R0, 0
        ST R0, [R1]
        LDI R2, B_PROGEND
        ST R1, [R2]
; b_clearvars: no variables, no FOR or GOSUB frames.
b_clearvars: LDI R2, B_PROGEND
        LD R1, [R2]
        INC R1
        LDI R2, B_VAREND
        ST R1, [R2]
        LDI R1, CSTACK
        LDI R2, B_CSP
        ST R1, [R2]
        RET

; b_relink: is the memory from 243 a program? Every record must be at least
; 3 words long, end with 0, stay below B_MEMTOP, and have a line number
; above the one before (1 ... 65,535). Sets B_PROGEND and R0 = 1; if it
; isn't a program: NEW and R0 = 0.
b_relink: LDI R1, PROGRAM_START
        LDI R3, 0                       ; the previous line number
brl_loop: LD R0, [R1]
        JZ brl_end
        LDI R2, 3
        CMP R0, R2
        JN brl_bad
        MOV R2, R1
        ADD R2, R0                      ; the next record
        LDI R4, B_MEMTOP
        CMP R2, R4
        JGE brl_bad
        LD R4, [R2-1]
        JNZ brl_bad                     ; the text must end with 0
        LD R4, [R1+1]
        CMP R4, R3
        JLE brl_bad
        LDI R5, 65535
        CMP R4, R5
        JP brl_bad
        MOV R3, R4
        MOV R1, R2
        JMP brl_loop
brl_end: LDI R2, B_PROGEND
        ST R1, [R2]
        LDI R0, 1
        RET
brl_bad: JSR b_new
        LDI R0, 0
        RET

; b_findline: R0 = a line number. R0 = its record, or 0 (S set from R0).
b_findline: LDI R1, PROGRAM_START
bfl_loop: LD R2, [R1]
        JZ bfl_none
        LD R2, [R1+1]
        CMP R2, R0
        JZ bfl_found
        LD R2, [R1]
        ADD R1, R2
        JMP bfl_loop
bfl_found: MOV R0, R1
        RET
bfl_none: LDI R0, 0
        RET

; ===========================================================================
; Variables and arrays (M15: typed entries of any length)
; ===========================================================================

; b_varname: reads the name at R7 into B_IDENT (upper case, 0-terminated) and
; moves R7 past it. R0 = 1 for a string name (ending in '$'), else 0. A name
; is a letter and at most 7 more letters or digits, plus the '$'.
b_varname: MOV R1, R7
        JSR b_scanword
        ADD R7, R0
        LDI R2, 9
        CMP R0, R2
        JP err_syntax
        LDI R2, B_IDENT - 1
        ADD R2, R0
        LD R1, [R2]                     ; the last character
        LDI R2, '$'
        CMP R1, R2
        JZ bvn_str
        LDI R2, 8
        CMP R0, R2
        JP err_syntax
        LDI R0, 0
        RET
bvn_str: LDI R0, 1
        RET

; b_arrname: R0 = the length of the name in B_IDENT; appends '(' to it, which
; is how an array's entry is told apart from a plain variable's.
b_arrname: LDI R2, B_IDENT
        ADD R2, R0
        LDI R1, '('
        ST R1, [R2]
        LDI R1, 0
        ST R1, [R2+1]
        RET

; b_findvar: R0 = the entry named B_IDENT, or 0 (S set from R0). Keeps R3 ... R8.
b_findvar: PUSH R3
        PUSH R4
        LDI R2, B_PROGEND
        LD R3, [R2]
        INC R3                          ; the first entry
bfv_next: LDI R2, B_VAREND
        LD R0, [R2]
        CMP R3, R0
        JGE bfv_none
        LDI R4, 0                       ; character index
bfv_cmp: MOV R1, R3
        ADD R1, R4
        LD R0, [R1+1]
        LDI R2, B_IDENT
        ADD R2, R4
        LD R2, [R2]
        CMP R0, R2
        JNZ bfv_skip
        MOV R0, R0
        JZ bfv_found                    ; both names end here
        INC R4
        LDI R2, NAMELEN
        CMP R4, R2
        JN bfv_cmp
bfv_found: MOV R0, R3
        JMP bfv_ret
bfv_skip: LD R0, [R3]                   ; the entry's length: on to the next
        ADD R3, R0
        JMP bfv_next
bfv_none: LDI R0, 0
bfv_ret: POP R4
        POP R3
        MOV R0, R0
        RET

; b_newvar: R0 = how many data words. Makes an entry named B_IDENT at the
; end of the variables, all 0; R0 = its address. Keeps R3 ... R8.
b_newvar: PUSH R3
        MOV R3, R0
        ADDI R3, VARHEAD                ; the whole entry's length
        LDI R2, B_VAREND
        LD R0, [R2]
        MOV R1, R0
        ADD R1, R3                      ; the new end of the variables
        LDI R2, B_MEMTOP
        CMP R1, R2
        JP err_memory
        LDI R2, B_VAREND
        ST R1, [R2]
        ST R3, [R0]
        PUSH R0
        INC R0
bnv_zero: CMP R0, R1
        JGE bnv_name
        LDI R2, 0
        ST R2, [R0]
        INC R0
        JMP bnv_zero
bnv_name: POP R0
        LDI R3, B_IDENT
        MOV R1, R0
        INC R1
bnv_copy: LD R2, [R3]
        JZ bnv_done
        ST R2, [R1]
        INC R3
        INC R1
        JMP bnv_copy
bnv_done: POP R3
        RET

; b_varref: R7 is at a name. R0 = the address of its value (a number) or of
; its SLOT (a string), and B_TYPE says which. "NAME(index)" is an array
; element; an array used before DIM gets 0 ... 10. A variable is made the
; first time it is used, with the value 0 or the empty string.
b_varref: PUSH R3
        PUSH R4
        MOV R3, R7                      ; where the name starts
        JSR b_varname
        MOV R4, R0                      ; the type
        JSR b_skip
        LDI R2, '('
        CMP R0, R2
        JZ bvr_array
        JSR b_findvar
        JNZ bvr_have
        LDI R0, 1                       ; a new variable: 1 word or a SLOT
        MOV R4, R4
        JZ bvr_new
        LDI R0, SLOT
bvr_new: JSR b_newvar
bvr_have: ADDI R0, VARHEAD
        JMP bvr_type
bvr_array: INC R7
        PUSH R3
        PUSH R4
        JSR b_numexpr                   ; the index (it may use other names)
        POP R4
        POP R3
        PUSH R0
        JSR b_skip
        LDI R2, ')'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        MOV R1, R3                      ; the array's name again
        JSR b_scanword
        JSR b_arrname
        JSR b_findvar
        JNZ bvr_arrhave
        LDI R0, 0                       ; not DIMmed: 0 ... 10
        LDI R1, 10
        MOV R2, R4
        JSR b_mkarray
bvr_arrhave: POP R1
        JSR b_element
bvr_type: LDI R2, B_TYPE
        ST R4, [R2]
        POP R4
        POP R3
        RET

; b_mkarray: R0 = lowest index, R1 = highest, R2 = type. Makes the array
; entry named B_IDENT: [low][high] and the elements. R0 = the entry.
b_mkarray: PUSH R3
        PUSH R4
        PUSH R2
        MOV R3, R0
        MOV R4, R1
        MOV R0, R4                      ; count = high - low + 1
        MOV R1, R3
        NEG R1
        JSR b_addflag
        MOV R2, R2
        JNZ err_memory
        INC R0
        JLE err_subscript               ; high below low
        MOV R1, R0
        POP R2
        PUSH R2
        MOV R2, R2
        JZ bma_num
        LDI R2, 494                     ; 494 strings would fill all memory
        CMP R1, R2
        JP err_memory
        LDI R2, SLOT
        MUL R1, R2
        JMP bma_make
bma_num: LDI R2, B_MEMTOP
        CMP R1, R2
        JP err_memory
bma_make: MOV R0, R1
        ADDI R0, 2
        JSR b_newvar
        ST R3, [R0+VARHEAD]
        ST R4, [R0+VARHEAD+1]
        POP R2
        POP R4
        POP R3
        RET

; b_element: R0 = an array entry, R1 = an index, R4 = the type. R0 = the
; element's address; outside low ... high is ?BAD SUBSCRIPT.
b_element: LD R2, [R0+VARHEAD]
        CMP R1, R2
        JN err_subscript
        LD R2, [R0+VARHEAD+1]
        CMP R1, R2
        JP err_subscript
        LD R2, [R0+VARHEAD]
        SUB R1, R2                      ; 0 ... count - 1
        MOV R4, R4
        JZ bel_num
        LDI R2, SLOT
        MUL R1, R2
bel_num: ADD R0, R1
        ADDI R0, VARHEAD + 2
        RET

; ===========================================================================
; Strings: SLOTs of [length][characters]
; ===========================================================================

; b_tmpnew: R0 = a fresh string temp. Temps live until the next statement.
b_tmpnew: LDI R2, B_TMP
        LD R0, [R2]
        MOV R1, R0
        ADDI R1, SLOT
        LDI R2, TEMP_END
        CMP R1, R2
        JP err_memory
        LDI R2, B_TMP
        ST R1, [R2]
        RET

; b_littemp: R7 is at '"': the text up to the closing '"' becomes a temp
; string (R0); R7 moves past it.
b_littemp: PUSH R3
        JSR b_tmpnew
        PUSH R0
        MOV R1, R0
        INC R7
        LDI R3, '"'
blt_loop: LD R2, [R7]
        JZ blt_end
        INC R7
        CMP R2, R3
        JZ blt_end
        INC R1
        ST R2, [R1]
        JMP blt_loop
blt_end: POP R0
        SUB R1, R0
        ST R1, [R0]                     ; the length
        POP R3
        RET

; b_copychars: R0 = where to, R1 = a string: copies its characters there;
; R0 = just after them. Changes R1, R2; keeps R3 ... R8.
b_copychars: PUSH R3
        LD R3, [R1]
bcc_loop: MOV R3, R3
        JZ bcc_ret
        INC R1
        LD R2, [R1]
        ST R2, [R0]
        INC R0
        DEC R3
        JMP bcc_loop
bcc_ret: POP R3
        RET

; b_strcopy: R0 = a SLOT, R1 = a string: the SLOT gets a copy of it.
b_strcopy: LD R2, [R1]
        ST R2, [R0]
        INC R0
        JMP b_copychars

; b_concat: R0 + R1 (two strings) as a new temp; over 80 characters is
; ?STRING TOO LONG.
b_concat: PUSH R3
        PUSH R4
        PUSH R5
        MOV R3, R0
        MOV R4, R1
        LD R0, [R3]
        LD R1, [R4]
        ADD R0, R1
        LDI R2, LINE_LEN
        CMP R0, R2
        JP err_toolong
        PUSH R0
        JSR b_tmpnew
        MOV R5, R0
        POP R1
        ST R1, [R5]
        MOV R0, R5
        INC R0
        MOV R1, R3
        JSR b_copychars
        MOV R1, R4
        JSR b_copychars
        MOV R0, R5
        POP R5
        POP R4
        POP R3
        RET

; b_strcmp: compares the strings R0 and R1 in alphabetical (character code)
; order: R0 = -1, 0 or +1, like CMP. A string that is the start of a longer
; one comes first.
b_strcmp: PUSH R3
        PUSH R4
        PUSH R5
        MOV R3, R0
        MOV R4, R1
        LD R5, [R3]                     ; length of the first
        LDI R0, 0                       ; characters compared
bsc_loop: CMP R0, R5
        JZ bsc_aend
        LD R1, [R4]
        CMP R0, R1
        JZ bsc_more                     ; the second has ended first
        MOV R1, R3
        ADD R1, R0
        LD R1, [R1+1]
        MOV R2, R4
        ADD R2, R0
        LD R2, [R2+1]
        CMP R1, R2
        JN bsc_less
        JP bsc_more
        INC R0
        JMP bsc_loop
bsc_aend: LD R1, [R4]
        CMP R0, R1
        JZ bsc_same
bsc_less: LDI R0, -1
        JMP bsc_ret
bsc_more: LDI R0, 1
        JMP bsc_ret
bsc_same: LDI R0, 0
bsc_ret: POP R5
        POP R4
        POP R3
        RET

; b_printstr: prints the string R0. Keeps R3 ... R8.
b_printstr: PUSH R3
        PUSH R4
        MOV R4, R0
        LD R3, [R4]
bps_loop: MOV R3, R3
        JZ bps_ret
        INC R4
        LD R0, [R4]
        JSR putchar
        DEC R3
        JMP bps_loop
bps_ret: POP R4
        POP R3
        RET

; b_substr: R0 = a string, R1 = the first character (1 = the first), R2 = how
; many. Both are clamped to the string, so it never fails. R0 = a new temp.
b_substr: PUSH R3
        PUSH R4
        PUSH R5
        MOV R3, R0
        MOV R4, R1
        MOV R5, R2
        MOV R4, R4
        JP bsb_start
        LDI R4, 1                       ; before the first: from the first
bsb_start: LD R0, [R3]
        SUB R0, R4
        INC R0                          ; characters from R4 to the end
        JGE bsb_avail
        LDI R0, 0
bsb_avail: CMP R5, R0
        JLE bsb_n
        MOV R5, R0
bsb_n:  MOV R5, R5
        JGE bsb_copy
        LDI R5, 0
bsb_copy: JSR b_tmpnew
        ST R5, [R0]
        PUSH R0
        MOV R1, R3
        ADD R1, R4                      ; the first character to copy
        MOV R2, R0
bsb_loop: MOV R5, R5
        JZ bsb_done
        LD R3, [R1]
        INC R2
        ST R3, [R2]
        INC R1
        DEC R5
        JMP bsb_loop
bsb_done: POP R0
        POP R5
        POP R4
        POP R3
        RET

; b_numtostr: R0 = a number; R0 = its decimal text as a new temp (STR$).
b_numtostr: PUSH R3
        PUSH R4
        PUSH R5
        MOV R3, R0
        JSR b_tmpnew
        MOV R4, R0                      ; the temp
        MOV R5, R0                      ; where the last character went
        MOV R3, R3
        JGE bns_pos
        LDI R0, '-'
        INC R5
        ST R0, [R5]
        NEG R3
bns_pos: LDI R1, 0                      ; digits on the stack
bns_dig: MOV R0, R3
        LDI R2, 10
        MOD R0, R2                      ; rounds: 7 MOD 10 = -3 ...
        JGE bns_ok
        ADD R0, R2                      ; ... so add 10 back
bns_ok: SUB R3, R0
        DIV R3, R2
        ADDI R0, '0'
        PUSH R0
        INC R1
        MOV R3, R3
        JNZ bns_dig
bns_out: POP R0
        INC R5
        ST R0, [R5]
        DEC R1
        JNZ bns_out
        SUB R5, R4
        ST R5, [R4]
        MOV R0, R4
        POP R5
        POP R4
        POP R3
        RET

; b_terntostr: R0 = a number; R0 = its balanced-ternary text as a new temp,
; without leading zeros (TERN$(6) = "+-0"). n MOD 3 is the lowest trit.
b_terntostr: PUSH R3
        PUSH R4
        PUSH R5
        PUSH R6
        MOV R3, R0
        JSR b_tmpnew
        MOV R4, R0
        MOV R5, R0
        LDI R6, 12                      ; all 12 trits, lowest first
btt_take: MOV R0, R3
        LDI R1, 3
        MOD R0, R1
        PUSH R0
        DIV R3, R1
        DEC R6
        JNZ btt_take
        LDI R6, 12
        LDI R3, 0                       ; 1 once a non-zero trit has come
btt_show: POP R0
        MOV R0, R0
        JNZ btt_put
        MOV R3, R3
        JNZ btt_put
        LDI R1, 1
        CMP R6, R1
        JZ btt_put                      ; the very last trit: even a 0
        JMP btt_next
btt_put: LDI R3, 1
        MOV R0, R0
        BR3 btt_minus, btt_zero, btt_plus
btt_minus: LDI R1, '-'
        JMP btt_store
btt_zero: LDI R1, '0'
        JMP btt_store
btt_plus: LDI R1, '+'
btt_store: INC R5
        ST R1, [R5]
btt_next: DEC R6
        JNZ btt_show
        SUB R5, R4
        ST R5, [R4]
        MOV R0, R4
        POP R6
        POP R5
        POP R4
        POP R3
        RET

; ===========================================================================
; Expressions (SPEC 10.2): each level calls the next higher one.
;   OR < AND < comparisons < + - < * / MOD < unary - NOT < ( ), numbers, names
; Every level returns the value in R0, its type in B_TYPE, and keeps
; unfinished values (and their types) on the stack.
; ===========================================================================

; b_numexpr / b_strexpr: an expression that must be a number / a string.
b_numexpr: JSR b_expr
b_neednum: LDI R2, B_TYPE               ; keeps R0, R1
        LD R2, [R2]
        JNZ err_type
        RET
b_strexpr: JSR b_expr
        LDI R2, B_TYPE
        LD R2, [R2]
        JZ err_type
        RET

; b_isnum / b_isstr: set B_TYPE. Keep R0.
b_isnum: LDI R1, 0
        LDI R2, B_TYPE
        ST R1, [R2]
        RET
b_isstr: LDI R1, 1
        LDI R2, B_TYPE
        ST R1, [R2]
        RET

; b_expr: OR = the trit-wise maximum (Kleene's OR on TRUE/UNKNOWN/FALSE).
b_expr: JSR b_and
bx_loop: PUSH R0
        JSR b_skip
        LDI R2, T_OR
        CMP R0, R2
        JNZ bx_done
        JSR b_neednum
        INC R7
        JSR b_and
        JSR b_neednum
        POP R1
        MAX R0, R1
        JMP bx_loop
bx_done: POP R0
        RET

; b_and: AND = the trit-wise minimum.
b_and:  JSR b_cmp
ba_loop: PUSH R0
        JSR b_skip
        LDI R2, T_AND
        CMP R0, R2
        JNZ ba_done
        JSR b_neednum
        INC R7
        JSR b_cmp
        JSR b_neednum
        POP R1
        MIN R0, R1
        JMP ba_loop
ba_done: POP R0
        RET

; b_cmp: = <> < > <= >= give TRUE (1) or FALSE (-1); <=> gives the sign of
; the difference. Two strings compare alphabetically. CMP compares without
; wrapping and leaves -1, 0 or +1 in S; BR3 turns that into 0, 1 or 2, and
; reltab holds each operator's three answers.
b_cmp:  JSR b_add
bc_loop: PUSH R0
        LDI R2, B_TYPE
        LD R2, [R2]
        PUSH R2                         ; the left side's type
        JSR b_relop                     ; R0 = operator 0 ... 6, or -1
        JN bc_done
        PUSH R0
        JSR b_add
        MOV R1, R0                      ; right
        POP R3                          ; operator
        POP R2                          ; left type
        LDI R0, B_TYPE
        LD R0, [R0]
        CMP R0, R2
        JNZ err_type                    ; a number and a string
        POP R0                          ; left
        MOV R2, R2
        JZ bc_compare
        JSR b_strcmp                    ; strings: R0 = -1, 0 or +1 ...
        LDI R1, 0                       ; ... compared with 0 below
bc_compare: CMP R0, R1
        BR3 bc_lt, bc_eq, bc_gt
bc_lt:  LDI R2, 0
        JMP bc_pick
bc_eq:  LDI R2, 1
        JMP bc_pick
bc_gt:  LDI R2, 2
bc_pick: MOV R0, R3
        SHT R0, 1                       ; operator * 3
        ADD R0, R2
        LDI R2, reltab
        ADD R0, R2
        LD R0, [R0]
        JSR b_isnum                     ; a comparison is always a number
        JMP bc_loop
bc_done: POP R2
        LDI R1, B_TYPE
        ST R2, [R1]
        POP R0
        RET

; reltab: for each operator the answer when left < right, =, >.
reltab: .word -1, 1, -1                 ; 0  =
        .word 1, -1, 1                  ; 1  <>
        .word 1, -1, -1                 ; 2  <
        .word -1, -1, 1                 ; 3  >
        .word 1, 1, -1                  ; 4  <=
        .word -1, 1, 1                  ; 5  >=
        .word -1, 0, 1                  ; 6  <=>

; b_relop: R0 = the comparison operator at R7 (number as in reltab), moving
; R7 past it; or -1, R7 unchanged. S is set from R0.
b_relop: JSR b_skip
        LDI R2, '='
        CMP R0, R2
        JZ brl_eq
        LDI R2, '<'
        CMP R0, R2
        JZ brl_lt
        LDI R2, '>'
        CMP R0, R2
        JZ brl_gt
        LDI R0, -1
        RET
brl_eq: INC R7
        LDI R0, 0
        RET
brl_lt: INC R7
        LD R0, [R7]
        LDI R2, '>'
        CMP R0, R2
        JZ brl_ne
        LDI R2, '='
        CMP R0, R2
        JZ brl_le
        LDI R0, 2
        RET
brl_ne: INC R7
        LDI R0, 1
        RET
brl_le: INC R7
        LD R0, [R7]
        LDI R2, '>'
        CMP R0, R2
        JZ brl_cmp3
        LDI R0, 4
        RET
brl_cmp3: INC R7
        LDI R0, 6
        RET
brl_gt: INC R7
        LD R0, [R7]
        LDI R2, '='
        CMP R0, R2
        JZ brl_ge
        LDI R0, 3
        RET
brl_ge: INC R7
        LDI R0, 5
        RET

; b_add: + (numbers, or joining two strings) and - (numbers), with
; ?OVERFLOW ERROR outside the word range.
b_add:  JSR b_mul
bad_loop: PUSH R0
        LDI R2, B_TYPE
        LD R2, [R2]
        PUSH R2                         ; the left side's type
        JSR b_skip
        LDI R2, '+'
        CMP R0, R2
        JZ bad_plus
        LDI R2, '-'
        CMP R0, R2
        JZ bad_minus
        POP R2
        LDI R1, B_TYPE
        ST R2, [R1]
        POP R0
        RET
bad_plus: INC R7
        JSR b_mul
        MOV R1, R0                      ; right
        POP R2                          ; left type
        LDI R0, B_TYPE
        LD R0, [R0]
        CMP R0, R2
        JNZ err_type
        POP R0                          ; left
        MOV R2, R2
        JNZ bad_join
        JSR b_addchk
        JMP bad_loop
bad_join: JSR b_concat
        JMP bad_loop
bad_minus: INC R7
        POP R2
        MOV R2, R2
        JNZ err_type                    ; a string minus anything
        JSR b_mul
        JSR b_neednum
        NEG R0                          ; never overflows: the range is symmetric
        MOV R1, R0
        POP R0
        JSR b_addchk
        JMP bad_loop

; b_addflag: R0 = R0 + R1 and R2 = 0; or, if the sum leaves the word range,
; R0 unchanged and R2 = 1. No instruction can branch on the O flag, so it is
; tested before adding: for b >= 0, a + b > 265,720 exactly when
; a > 265,720 - b (which can't overflow), and the same downwards.
b_addflag: MOV R1, R1
        JN baf_neg
        LDI R2, 265720
        SUB R2, R1
        CMP R0, R2
        JP baf_over
        JMP baf_add
baf_neg: LDI R2, -265720
        SUB R2, R1
        CMP R0, R2
        JN baf_over
baf_add: ADD R0, R1
        LDI R2, 0
        RET
baf_over: LDI R2, 1
        RET

b_addchk: JSR b_addflag
        MOV R2, R2
        JNZ err_overflow
        RET

; b_mul: *, / and MOD (numbers only). * wraps like the CPU's MUL (SPEC 10.2);
; / and MOD round to the nearest whole number like DIV and MOD.
b_mul:  JSR b_unary
bmu_loop: PUSH R0
        JSR b_skip
        LDI R2, '*'
        CMP R0, R2
        JZ bmu_times
        LDI R2, '/'
        CMP R0, R2
        JZ bmu_div
        LDI R2, T_MOD
        CMP R0, R2
        JZ bmu_mod
        POP R0
        RET
bmu_times: JSR b_neednum
        INC R7
        JSR b_unary
        JSR b_neednum
        POP R1
        MUL R0, R1
        JMP bmu_loop
bmu_div: JSR b_neednum
        INC R7
        JSR b_unary
        JSR b_neednum
        MOV R1, R0
        POP R0
        MOV R1, R1
        JZ err_div0
        DIV R0, R1
        JMP bmu_loop
bmu_mod: JSR b_neednum
        INC R7
        JSR b_unary
        JSR b_neednum
        MOV R1, R0
        POP R0
        MOV R1, R1
        JZ err_div0
        MOD R0, R1
        JMP bmu_loop

; b_unary: -x and NOT x. Both are NEG: in balanced ternary, flipping every
; trit is the negative number and also NOT TRUE = FALSE, NOT UNKNOWN = UNKNOWN.
b_unary: JSR b_skip
        LDI R2, '-'
        CMP R0, R2
        JZ bun_neg
        LDI R2, T_NOT
        CMP R0, R2
        JZ bun_neg
        JMP b_primary
bun_neg: INC R7
        JSR b_unary
        JSR b_neednum
        NEG R0
        RET

; b_primary: a number, "text", ( expression ), TRUE / FALSE / UNKNOWN, a
; function, or a variable (one never assigned is 0, UNKNOWN, or "").
b_primary: JSR b_skip
        JSR b_isdigit
        MOV R1, R1
        JZ bpr_other
        JSR b_number
        JZ err_overflow
        JN err_syntax
        JMP b_isnum
bpr_other: LDI R2, '('
        CMP R0, R2
        JZ bpr_paren
        LDI R2, '"'
        CMP R0, R2
        JZ bpr_text
        LDI R2, T_TRUE
        CMP R0, R2
        JZ bpr_true
        LDI R2, T_FALSE
        CMP R0, R2
        JZ bpr_false
        LDI R2, T_UNKNOWN
        CMP R0, R2
        JZ bpr_unknown
        LDI R2, T_FIRSTFN               ; -51 ... -68: a function
        CMP R0, R2
        JLE bpr_function
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        JSR b_varref
        LDI R2, B_TYPE
        LD R2, [R2]
        JNZ bpr_ret                     ; a string: its SLOT's address
        LD R0, [R0]                     ; a number: its value
bpr_ret: RET
bpr_text: JSR b_littemp
        JMP b_isstr
bpr_paren: INC R7
        JSR b_expr
        PUSH R0
        JSR b_skip
        LDI R2, ')'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        POP R0
        RET
bpr_true: INC R7
        LDI R0, 1
        JMP b_isnum
bpr_false: INC R7
        LDI R0, -1
        JMP b_isnum
bpr_unknown: INC R7
        LDI R0, 0
        JMP b_isnum
bpr_function: INC R7
        NEG R0                          ; 51 ... 68
        LDI R2, fntab - 51
        ADD R0, R2
        LD R0, [R0]
        PUSH R0                         ; jump there; its RET returns to our caller
        RET

; ===========================================================================
; Functions (SPEC 10.6.3, 10.4). Each starts just past its keyword and
; returns its value in R0 with B_TYPE set.
; ===========================================================================

; argument helpers
b_open: JSR b_skip
        LDI R2, '('
        CMP R0, R2
        JNZ err_syntax
        INC R7
        RET
b_comma: JSR b_skip
        LDI R2, ','
        CMP R0, R2
        JNZ err_syntax
        INC R7
        RET
b_close: PUSH R0                        ; keeps R0
        JSR b_skip
        LDI R2, ')'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        POP R0
        RET
b_numarg: JSR b_open                    ; "(number)"
        JSR b_numexpr
        JMP b_close
b_strarg: JSR b_open                    ; "(string)"
        JSR b_strexpr
        JMP b_close

fn_abs: JSR b_numarg
        MOV R0, R0
        JGE b_isnum
        NEG R0
        JMP b_isnum

fn_sgn: JSR b_numarg
        MOV R0, R0
        BR3 fsg_neg, b_isnum, fsg_pos
fsg_neg: LDI R0, -1
        JMP b_isnum
fsg_pos: LDI R0, 1
        JMP b_isnum

; RND(n): 1 ... n from the RAND register (0 if n < 1). MOD rounds, so a
; negative remainder gets n added.
fn_rnd: JSR b_numarg
        MOV R1, R0
        JLE frn_none
        LDI R2, IO_BASE
        LD R0, [R2+RAND]
        MOD R0, R1
        JGE frn_ok
        ADD R0, R1
frn_ok: INC R0
        JMP b_isnum
frn_none: LDI R0, 0
        JMP b_isnum

fn_peek: JSR b_numarg
        LD R0, [R0]
        JMP b_isnum

fn_joyx: LDI R2, IO_BASE
        LD R0, [R2+JOY_X]
        JMP b_isnum

fn_joyy: LDI R2, IO_BASE
        LD R0, [R2+JOY_Y]
        JMP b_isnum

; BTN(n): button A, B or C (n = 1, 2, 3); 0 for any other n.
fn_btn: JSR b_numarg
        MOV R1, R0
        LDI R0, 0
        MOV R1, R1
        JLE b_isnum
        LDI R2, 3
        CMP R1, R2
        JP b_isnum
        LDI R2, IO_BASE + BTN_A - 1
        ADD R2, R1
        LD R0, [R2]
        JMP b_isnum

fn_inkey: JSR b_key                     ; keys typed earlier come first
        JMP b_isnum

fn_frame: LDI R2, IO_BASE
        LD R0, [R2+FRAME]
        JMP b_isnum

fn_len: JSR b_strarg
        LD R0, [R0]
        JMP b_isnum

fn_left: JSR b_open
        JSR b_strexpr
        PUSH R0
        JSR b_comma
        JSR b_numexpr
        JSR b_close
        MOV R2, R0
        POP R0
        LDI R1, 1
        JSR b_substr
        JMP b_isstr

fn_right: JSR b_open
        JSR b_strexpr
        PUSH R0
        JSR b_comma
        JSR b_numexpr
        JSR b_close
        MOV R2, R0                      ; how many
        POP R0
        LD R1, [R0]
        SUB R1, R2
        INC R1                          ; from length - n + 1
        JSR b_substr
        JMP b_isstr

fn_mid: JSR b_open
        JSR b_strexpr
        PUSH R0
        JSR b_comma
        JSR b_numexpr
        PUSH R0                         ; the first character
        JSR b_comma
        JSR b_numexpr
        JSR b_close
        MOV R2, R0                      ; how many
        POP R1
        POP R0
        JSR b_substr
        JMP b_isstr

fn_chr: JSR b_numarg
        PUSH R0
        JSR b_tmpnew
        POP R1
        ST R1, [R0+1]
        LDI R1, 1
        ST R1, [R0]
        JMP b_isstr

fn_asc: JSR b_strarg                    ; the first character's code, 0 for ""
        LD R1, [R0]
        JZ fas_empty
        LD R0, [R0+1]
        JMP b_isnum
fas_empty: LDI R0, 0
        JMP b_isnum

fn_str: JSR b_numarg
        JSR b_numtostr
        JMP b_isstr

fn_tern: JSR b_numarg
        JSR b_terntostr
        JMP b_isstr

; VAL(s$): the number at the start of s$ (spaces, a sign, decimal or 0T
; trits); 0 if there is none.
fn_val: JSR b_strarg
        PUSH R0
        JSR b_tmpnew                    ; the characters, 0-terminated, to read
        POP R1
        PUSH R0
        JSR b_copychars
        LDI R1, 0
        ST R1, [R0]
        POP R0
        PUSH R7
        MOV R7, R0
        JSR b_skip
        LDI R3, 1
        LDI R2, '-'
        CMP R0, R2
        JNZ fvl_digit
        LDI R3, -1
        INC R7
fvl_digit: LD R0, [R7]
        JSR b_isdigit
        MOV R1, R1
        JZ fvl_none
        JSR b_number
        JLE fvl_none
        MUL R0, R3
        JMP fvl_ret
fvl_none: LDI R0, 0
fvl_ret: POP R7
        JMP b_isnum

; ===========================================================================
; Statements. Each is reached with R7 just past its keyword, and returns to
; b_after; the ones that move elsewhere (GOTO, NEXT, ...) jump to b_goline,
; b_resume or b_comeback, which reset the stack.
; ===========================================================================

; --- PRINT items: expressions (numbers or strings); ';' joins, ',' goes to
; the next of the 9-column zones; a ';' or ',' at the end keeps the cursor on
; the line.
st_print: LDI R3, 1                     ; 1 = end with a new line
spr_loop: JSR b_skip
        JZ spr_end
        LDI R2, ':'
        CMP R0, R2
        JZ spr_end
        LDI R2, T_MAYBE
        CMP R0, R2
        JZ spr_end
        LDI R2, T_ELSE
        CMP R0, R2
        JZ spr_end
        LDI R2, ';'
        CMP R0, R2
        JZ spr_semi
        LDI R2, ','
        CMP R0, R2
        JZ spr_comma
        JSR b_expr
        LDI R2, B_TYPE
        LD R2, [R2]
        JNZ spr_string
        JSR printnum
        LDI R3, 1
        JMP spr_loop
spr_string: JSR b_printstr
        LDI R3, 1
        JMP spr_loop
spr_semi: INC R7
        LDI R3, 0
        JMP spr_loop
spr_comma: INC R7
        JSR b_zone
        LDI R3, 0
        JMP spr_loop
spr_end: MOV R3, R3
        JZ spr_ret
        LDI R0, 10
        JMP putchar
spr_ret: RET

; b_zone: spaces up to the next zone (columns 0, 9, 18), at least one.
b_zone: LDI R0, ' '
        JSR putchar
bzn_loop: LDI R2, CURSOR_X
        LD R0, [R2]
        LDI R1, 9
        MOD R0, R1                      ; 0 exactly at 0, 9, 18 and 27
        JZ bzn_ret
        LDI R0, ' '
        JSR putchar
        JMP bzn_loop
bzn_ret: RET

; --- INPUT ["prompt";] var: "? " and a line. A string variable takes the
; line as it is; a number variable a number (decimal or 0T...), and anything
; else gets ?REDO and another try. Esc is BREAK.
st_input: JSR b_skip
        LDI R2, '"'
        CMP R0, R2
        JNZ sin_var
        JSR b_strlit
        JSR b_skip
        LDI R2, ';'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_skip
sin_var: JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        JSR b_varref
        PUSH R7                         ; the program's place: R7 reads INBUF now
        PUSH R0                         ; the variable
        LDI R2, B_TYPE
        LD R2, [R2]
        PUSH R2                         ; its type
sin_ask: LDI R0, msg_qmark
        JSR print
        LDI R0, INBUF
        LDI R1, 1
        JSR b_readline
        JNZ b_break                     ; Esc
        POP R2
        PUSH R2
        MOV R2, R2
        JNZ sin_text
        LDI R7, INBUF
        JSR b_signednum
        JNZ sin_got
        LDI R0, msg_redo
        JSR print
        JMP sin_ask
sin_got: POP R2
        POP R1
        ST R0, [R1]
        POP R7
        RET
sin_text: POP R2
        POP R0                          ; the SLOT
        LDI R1, INBUF
        LDI R2, 0                       ; length
sit_loop: LD R3, [R1]
        JZ sit_end
        INC R2
        PUSH R2
        ADD R2, R0
        ST R3, [R2]
        POP R2
        INC R1
        JMP sit_loop
sit_end: ST R2, [R0]
        POP R7
        RET

; b_signednum: a whole number with an optional sign at R7, and nothing after
; it but spaces. R0 = the number and R1 = 1, or R1 = 0 (S set from R1).
b_signednum: JSR b_skip
        LDI R3, 1                       ; the sign
        LDI R2, '-'
        CMP R0, R2
        JNZ bsn_plus
        LDI R3, -1
        INC R7
        JMP bsn_digits
bsn_plus: LDI R2, '+'
        CMP R0, R2
        JNZ bsn_digits
        INC R7
bsn_digits: LD R0, [R7]
        JSR b_isdigit
        MOV R1, R1
        JZ bsn_bad
        JSR b_number
        JLE bsn_bad
        MUL R0, R3
        PUSH R0
        JSR b_skip
        MOV R1, R0
        POP R0
        MOV R1, R1
        JNZ bsn_bad
        LDI R1, 1
        RET
bsn_bad: LDI R1, 0
        RET

; --- ASK "prompt"; var: prints "prompt (Y/N/?) " and waits for one key:
; Y = TRUE, N = FALSE, ? = UNKNOWN. Other keys are ignored, Esc is BREAK.
st_ask: JSR b_skip
        LDI R2, '"'
        CMP R0, R2
        JNZ err_syntax
        JSR b_strlit
        JSR b_skip
        LDI R2, ';'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_skip
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        JSR b_varref
        JSR b_neednum                   ; a truth value is a number
        PUSH R0                         ; the variable
        LDI R0, msg_yn
        JSR print
sak_key: JSR b_key
        JNZ sak_got
        WAIT
        JMP sak_key
sak_got: LDI R2, 27
        CMP R0, R2
        JZ b_break
        JSR b_upper
        LDI R2, 'Y'
        CMP R0, R2
        JZ sak_yes
        LDI R2, 'N'
        CMP R0, R2
        JZ sak_no
        LDI R2, '?'
        CMP R0, R2
        JNZ sak_key
        LDI R1, 0
        JMP sak_set
sak_yes: LDI R1, 1
        JMP sak_set
sak_no: LDI R1, -1
sak_set: PUSH R1
        JSR putchar                     ; the answer as typed (Y, N or ?) ...
        LDI R0, 10
        JSR putchar                     ; ... and a new line
        POP R0
        POP R1
        ST R0, [R1]
        RET

; --- LET var = expression (the word LET may be left out). A string
; variable needs a string, a number variable a number.
st_let: JSR b_skip
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
st_letvar: JSR b_varref
        PUSH R0                         ; where
        LDI R2, B_TYPE
        LD R2, [R2]
        PUSH R2                         ; and of which type
        JSR b_skip
        LDI R2, '='
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_expr
        POP R2
        LDI R1, B_TYPE
        LD R1, [R1]
        CMP R1, R2
        JNZ err_type
        POP R1
        MOV R2, R2
        JNZ slt_string
        ST R0, [R1]
        RET
slt_string: MOV R2, R0                  ; b_strcopy wants R0 = SLOT, R1 = string
        MOV R0, R1
        MOV R1, R2
        JMP b_strcopy

; --- GOTO line (an expression: GOTO 100 + 10 * K works too)
st_goto: JSR b_target
        JMP b_goline

; b_target: R1 = the record of the line the expression at R7 names.
b_target: JSR b_numexpr
        JSR b_findline
        JZ err_undef
        MOV R1, R0
        RET

; --- GOSUB line: a frame [line record][position][line number][F_GOSUB]
st_gosub: JSR b_target
        PUSH R1
        LDI R2, B_CSP
        LD R0, [R2]
        MOV R1, R0
        ADDI R1, 4
        LDI R2, CSTACK_END
        CMP R1, R2
        JP err_memory
        LDI R2, B_CSP
        ST R1, [R2]
        LDI R2, B_LINEPTR
        LD R1, [R2]
        ST R1, [R0]
        ST R7, [R0+1]
        LDI R2, B_LINE
        LD R1, [R2]
        ST R1, [R0+2]
        LDI R1, F_GOSUB
        ST R1, [R0+3]
        POP R1
        JMP b_goline

; --- RETURN: back to the newest GOSUB, ending any FOR loops started since
st_return: LDI R2, B_CSP
        LD R0, [R2]
srt_loop: LDI R2, CSTACK
        CMP R0, R2
        JLE err_return
        LD R1, [R0-1]                   ; the top frame's kind
        LDI R2, F_GOSUB
        CMP R1, R2
        JZ srt_found
        ADDI R0, -7                     ; a FOR frame: drop it
        JMP srt_loop
srt_found: ADDI R0, -4
        LDI R2, B_CSP
        ST R0, [R2]
        LD R7, [R0+1]
        LD R1, [R0+2]
        LDI R2, B_LINE
        ST R1, [R2]
        LD R1, [R0]
        JMP b_comeback

; --- FOR var = start TO limit [STEP step]: a frame [variable][limit][step]
; [line record][position][line number][F_FOR]. The body always runs at least
; once; NEXT decides whether to go round again.
st_for: JSR b_skip
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        JSR b_varref
        JSR b_neednum
        PUSH R0                         ; the variable
        JSR b_skip
        LDI R2, '='
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_numexpr
        POP R1
        ST R0, [R1]                     ; the start value
        PUSH R1
        JSR b_skip
        LDI R2, T_TO
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_numexpr
        PUSH R0                         ; the limit
        JSR b_skip
        LDI R2, T_STEP
        CMP R0, R2
        JNZ sfr_one
        INC R7
        JSR b_numexpr
        JMP sfr_step
sfr_one: LDI R0, 1
sfr_step: PUSH R0                       ; the step
        LD R0, [SP+2]                   ; the variable
        JSR b_dropfor
        LDI R2, B_CSP
        LD R0, [R2]
        MOV R1, R0
        ADDI R1, 7
        LDI R2, CSTACK_END
        CMP R1, R2
        JP err_memory
        LDI R2, B_CSP
        ST R1, [R2]
        POP R1
        ST R1, [R0+2]                   ; step
        POP R1
        ST R1, [R0+1]                   ; limit
        POP R1
        ST R1, [R0]                     ; variable
        LDI R2, B_LINEPTR
        LD R1, [R2]
        ST R1, [R0+3]
        ST R7, [R0+4]
        LDI R2, B_LINE
        LD R1, [R2]
        ST R1, [R0+5]
        LDI R1, F_FOR
        ST R1, [R0+6]
        RET

; b_dropfor: R0 = a variable. A FOR loop over it that is still open (above
; the newest GOSUB) ends now, with every loop started after it.
b_dropfor: PUSH R3
        LDI R2, B_CSP
        LD R1, [R2]
bdf_loop: LDI R2, CSTACK
        CMP R1, R2
        JLE bdf_ret
        LD R3, [R1-1]
        LDI R2, F_FOR
        CMP R3, R2
        JNZ bdf_ret                     ; a GOSUB frame: look no further
        ADDI R1, -7
        LD R3, [R1]
        CMP R3, R0
        JNZ bdf_loop
        LDI R2, B_CSP
        ST R1, [R2]
bdf_ret: POP R3
        RET

; --- NEXT [var]: adds the step; while the variable hasn't passed the limit,
; back to the loop's start.
st_next: JSR b_skip
        JSR b_isletter
        MOV R1, R1
        JZ snx_any
        JSR b_varref
        JSR b_neednum
        JMP snx_find
snx_any: LDI R0, 0                      ; 0 = the innermost loop
snx_find: LDI R2, B_CSP
        LD R1, [R2]
snx_loop: LDI R2, CSTACK
        CMP R1, R2
        JLE err_next
        LD R2, [R1-1]
        ADDI R2, -F_FOR
        JNZ err_next                    ; a GOSUB frame: no loop here
        ADDI R1, -7
        MOV R0, R0
        JZ snx_found
        LD R2, [R1]
        CMP R2, R0
        JZ snx_found
        JMP snx_loop                    ; a loop over another variable ends here
snx_found: MOV R0, R1
        ADDI R0, 7
        LDI R2, B_CSP
        ST R0, [R2]                     ; loops started after this one are gone
        PUSH R1
        LD R2, [R1]
        LD R0, [R2]                     ; the variable's value
        LD R1, [R1+2]                   ; + the step
        JSR b_addflag
        POP R1
        MOV R2, R2                      ; (after the POP, which sets S too)
        JNZ snx_done                    ; out of the word range: past any limit
        LD R2, [R1]
        ST R0, [R2]
        LD R2, [R1+2]                   ; the step's sign gives the direction
        MOV R2, R2
        BR3 snx_down, snx_again, snx_up
snx_up: LD R2, [R1+1]
        CMP R0, R2
        JP snx_done
        JMP snx_again
snx_down: LD R2, [R1+1]
        CMP R0, R2
        JN snx_done
snx_again: LD R7, [R1+4]                ; STEP 0 lands here every time
        LD R0, [R1+5]
        LDI R2, B_LINE
        ST R0, [R2]
        LD R1, [R1+3]
        JMP b_comeback
snx_done: LDI R2, B_CSP
        ST R1, [R2]                     ; the loop is over
        RET

; --- IF condition THEN ... MAYBE ... ELSE ...: one branch for each sign of
; the condition. BR3 is the CPU's three-way jump; it is the whole statement.
; A branch runs until MAYBE / ELSE (b_after ends the line there); a line
; number alone means GOTO.
st_if:  JSR b_numexpr
        PUSH R0
        JSR b_skip
        LDI R2, T_THEN
        CMP R0, R2
        JNZ err_syntax
        INC R7
        POP R0
        MOV R0, R0
        BR3 sif_false, sif_maybe, sif_then
sif_false: LDI R0, T_ELSE
        JMP sif_find
sif_maybe: LDI R0, T_MAYBE
sif_find: JSR b_findbranch
        JZ b_eol                        ; no such branch: the line is done
sif_then: JSR b_skip
        JSR b_isdigit
        MOV R1, R1
        JZ b_resume                     ; statements follow
        JSR b_linenum
        JZ err_syntax
        JSR b_findline
        JZ err_undef
        MOV R1, R0
        JMP b_goline

; b_findbranch: R0 = T_MAYBE or T_ELSE. Moves R7 past that keyword in this
; line; R0 = 1, or R0 = 0 if there is none. A nested IF owns the rest of
; the line, so the search stops there (and at REM). S is set from R0.
b_findbranch: PUSH R3
        MOV R3, R0
bfb_loop: LD R0, [R7]
        JZ bfb_none
        INC R7
        CMP R0, R3
        JZ bfb_found
        LDI R2, T_IF
        CMP R0, R2
        JZ bfb_none
        LDI R2, T_REM
        CMP R0, R2
        JZ bfb_none
        LDI R2, '"'
        CMP R0, R2
        JNZ bfb_loop
bfb_text: LD R0, [R7]                   ; skip text in quotes
        JZ bfb_none
        INC R7
        LDI R2, '"'
        CMP R0, R2
        JNZ bfb_text
        JMP bfb_loop
bfb_found: LDI R0, 1
        JMP bfb_ret
bfb_none: LDI R0, 0
bfb_ret: POP R3
        MOV R0, R0
        RET

; --- REM: the rest of the line is a remark
st_rem: LD R0, [R7]
        JZ srm_ret
        INC R7
        JMP st_rem
srm_ret: RET

; --- END: the program ends quietly; STOP: with "BREAK IN line"
st_end: JMP b_ready
st_stop: JMP b_break

; --- NEW
st_new: JSR b_new
        JMP b_ready

; --- RUN [line]: clears the variables, then runs from the first line (or
; from that line).
st_run: JSR b_skip
        JZ srn_first
        LDI R2, ':'
        CMP R0, R2
        JZ srn_first
        JSR b_target
        JMP srn_go
srn_first: LDI R1, PROGRAM_START
srn_go: PUSH R1
        JSR b_clearvars
        POP R1
        JMP b_goline

; --- MON: the machine-code monitor (its BASIC command comes back)
st_mon: LDI SP, STACK_TOP
        JMP monitor

; --- LIST [from][-][to]: LIST, LIST 100, LIST 100-200, LIST -200, LIST 100-
st_list: LDI R3, 1                      ; first line number to show
        LDI R4, 65535                   ; last
        JSR b_skip
        LDI R2, '-'
        CMP R0, R2
        JZ sls_to
        JSR b_isdigit
        MOV R1, R1
        JZ sls_go
        JSR b_linenum
        JZ err_syntax
        MOV R3, R0
        MOV R4, R0
        JSR b_skip
        LDI R2, '-'
        CMP R0, R2
        JNZ sls_go
        LDI R4, 65535
        INC R7
        JSR b_skip
        JSR b_isdigit
        MOV R1, R1
        JZ sls_go
        JSR b_linenum
        JZ err_syntax
        MOV R4, R0
        JMP sls_go
sls_to: INC R7
        JSR b_skip
        JSR b_isdigit
        MOV R1, R1
        JZ err_syntax
        JSR b_linenum
        JZ err_syntax
        MOV R4, R0
sls_go: LDI R5, PROGRAM_START
sls_line: JSR b_poll                    ; Esc stops a long listing
        LD R0, [R5]
        JZ sls_ret
        LD R6, [R5+1]
        CMP R6, R3
        JN sls_next
        CMP R6, R4
        JP sls_ret
        MOV R0, R6
        JSR printnum
        MOV R6, R5
        ADDI R6, 2
sls_char: LD R0, [R6]
        JZ sls_eol
        JN sls_kw
        JSR putchar
        JMP sls_cnext
sls_kw: NEG R0                          ; a token: print its keyword
        LDI R1, kwtab - 1
        ADD R1, R0
        LD R0, [R1]
        JSR print
sls_cnext: INC R6
        JMP sls_char
sls_eol: LDI R0, 10
        JSR putchar
sls_next: LD R0, [R5]
        ADD R5, R0
        JMP sls_line
sls_ret: RET

; --- DIM name(n) or name(low TO high), several separated by commas. An
; array that already exists is ?SYNTAX ERROR (D-051).
st_dim: JSR b_skip
        JSR b_isletter
        MOV R1, R1
        JZ err_syntax
        MOV R3, R7                      ; where the name starts
        JSR b_varname
        PUSH R0                         ; the type
        PUSH R3
        JSR b_skip
        LDI R2, '('
        CMP R0, R2
        JNZ err_syntax
        INC R7
        JSR b_numexpr
        PUSH R0                         ; the first number
        JSR b_skip
        LDI R2, T_TO
        CMP R0, R2
        JNZ sdm_upto
        INC R7
        JSR b_numexpr
        MOV R1, R0                      ; high
        POP R0                          ; low
        JMP sdm_close
sdm_upto: POP R1                        ; DIM A(n): 0 ... n
        LDI R0, 0
sdm_close: PUSH R0
        PUSH R1
        JSR b_skip
        LDI R2, ')'
        CMP R0, R2
        JNZ err_syntax
        INC R7
        LD R1, [SP+2]                   ; the name again
        JSR b_scanword
        JSR b_arrname
        JSR b_findvar
        JNZ err_syntax
        POP R1                          ; high
        POP R0                          ; low
        POP R3
        POP R2                          ; the type
        JSR b_mkarray
        JSR b_skip
        LDI R2, ','
        CMP R0, R2
        JNZ sdm_ret
        INC R7
        JMP st_dim
sdm_ret: RET

; ===========================================================================
; Machine statements (SPEC 10.6.2). Their numbers go to B_ARGS first.
; ===========================================================================

; b_args: R0 = how many numbers; reads them, separated by commas, into B_ARGS.
b_args: PUSH R3
        PUSH R4
        MOV R3, R0
        LDI R4, 0
bag_loop: MOV R4, R4
        JZ bag_first
        JSR b_comma
bag_first: PUSH R3
        PUSH R4
        JSR b_numexpr
        POP R4
        POP R3
        LDI R2, B_ARGS
        ADD R2, R4
        ST R0, [R2]
        INC R4
        CMP R4, R3
        JN bag_loop
        POP R4
        POP R3
        RET

; b_inrange: R0 = a number, R1 = the highest allowed: S = 0 if 0 <= R0 <= R1.
b_inrange: MOV R0, R0
        JN bir_no
        CMP R0, R1
        JP bir_no
        LDI R2, 0
        MOV R2, R2
        RET
bir_no: LDI R2, 1
        MOV R2, R2
        RET

; --- CLS
st_cls: JMP cls

; --- LOCATE column, row (clamped to the screen by the kernel)
st_locate: LDI R0, 2
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        LD R1, [R2+1]
        JMP locate

; --- TILE column, row, tile: one cell of the tile map (off the screen: nothing)
st_tile: LDI R0, 3
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        LDI R1, COLS - 1
        JSR b_inrange
        JNZ stl_ret
        LDI R2, B_ARGS
        LD R0, [R2+1]
        LDI R1, ROWS - 1
        JSR b_inrange
        JNZ stl_ret
        LDI R1, COLS
        MUL R0, R1                      ; row * 27
        LDI R2, B_ARGS
        LD R1, [R2]
        ADD R0, R1
        LDI R1, MAP
        ADD R0, R1
        LD R1, [R2+2]
        ST R1, [R0]
stl_ret: RET

; --- DEFTILE tile, row, p0 ... p7: one row of a tile, 8 pixel values. Each
; value is taken MOD 27, which in balanced ternary is exactly -13 ... 13.
st_deftile: LDI R0, 10
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        LDI R1, 242
        JSR b_inrange
        JNZ sdt_ret
        LDI R2, B_ARGS
        LD R0, [R2+1]
        LDI R1, 7
        JSR b_inrange
        JNZ sdt_ret
        LDI R2, B_ARGS
        LD R0, [R2]
        LDI R1, 16
        MUL R0, R1                      ; tile * 16
        LD R1, [R2+1]
        ADD R0, R1
        ADD R0, R1                      ; + row * 2
        LDI R1, TILES
        ADD R0, R1
        PUSH R0
        LDI R1, B_ARGS + 2
        JSR b_pack4                     ; pixels 0 ... 3
        POP R1
        ST R0, [R1]
        PUSH R1
        LDI R1, B_ARGS + 6
        JSR b_pack4                     ; pixels 4 ... 7
        POP R1
        ST R0, [R1+1]
sdt_ret: RET

; b_pack4: R1 = the address of 4 pixel values: R0 = them packed into one
; word, p0 * 19683 + p1 * 729 + p2 * 27 + p3 (SPEC 4.3).
b_pack4: PUSH R3
        PUSH R4
        LDI R0, 0
        LDI R3, 4
bpk_loop: LDI R2, 27
        MUL R0, R2
        LD R4, [R1]
        MOD R4, R2
        ADD R0, R4
        INC R1
        DEC R3
        JNZ bpk_loop
        POP R4
        POP R3
        RET

; --- SPRITE i, x, y, tile [, flags]: flags are +1 (shown) if left out
st_sprite: LDI R0, 4
        JSR b_args
        LDI R0, 1
        LDI R2, B_ARGS
        ST R0, [R2+4]
        JSR b_skip
        LDI R2, ','
        CMP R0, R2
        JNZ ssp_set
        INC R7
        JSR b_numexpr
        LDI R2, B_ARGS
        ST R0, [R2+4]
ssp_set: LDI R2, B_ARGS
        LD R0, [R2]
        LDI R1, 26
        JSR b_inrange
        JNZ ssp_ret
        SHT R0, 1
        LDI R2, B_ARGS
        LD R1, [R2]
        ADD R0, R1                      ; i * 4
        LDI R1, SPRITES
        ADD R0, R1
        LD R1, [R2+1]
        ST R1, [R0]
        LD R1, [R2+2]
        ST R1, [R0+1]
        LD R1, [R2+3]
        ST R1, [R0+2]
        LD R1, [R2+4]
        ST R1, [R0+3]
ssp_ret: RET

; --- SOUND voice (1 ... 3), frequency, volume, wave
st_sound: LDI R0, 4
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        ADDI R0, -1
        LDI R1, 2
        JSR b_inrange
        JNZ sso_ret
        SHT R0, 1                       ; (voice - 1) * 3
        LDI R1, IO_BASE + V1_FREQ
        ADD R0, R1
        LDI R2, B_ARGS
        LD R1, [R2+1]
        ST R1, [R0]
        LD R1, [R2+2]
        ST R1, [R0+1]
        LD R1, [R2+3]
        ST R1, [R0+2]
sso_ret: RET

; --- BORDER colour
st_border: JSR b_numexpr
        LDI R2, IO_BASE
        ST R0, [R2+BORDER]
        RET

; --- SCROLL x, y
st_scroll: LDI R0, 2
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        LD R1, [R2+1]
        LDI R2, IO_BASE
        ST R0, [R2+SCROLL_X]
        ST R1, [R2+SCROLL_Y]
        RET

; --- WAIT frames: sleeps that many frames (Esc still stops the program)
st_wait: JSR b_numexpr
swt_loop: MOV R0, R0
        JLE swt_ret
        WAIT
        PUSH R0
        JSR b_poll
        POP R0
        DEC R0
        JMP swt_loop
swt_ret: RET

; --- POKE address, value
st_poke: LDI R0, 2
        JSR b_args
        LDI R2, B_ARGS
        LD R0, [R2]
        LD R1, [R2+1]
        ST R1, [R0]
        RET

; --- SYS address: calls machine code there (JSR); it comes back with RET.
st_sys: JSR b_numexpr
b_call: PUSH R7                         ; R0 = the address
        LDI R1, ssy_back
        PUSH R1
        PUSH R0
        RET
ssy_back: POP R7
        RET

; --- COLOR foreground, background: re-colours the font (tiles 32 ... 126).
; Every pixel that has the font's current foreground colour gets the new
; foreground, every other pixel the new background. A pixel is w MOD 27 (the
; lowest three trits), and (w - pixel) / 27 is the rest of the word.
st_color: LDI R0, 2
        JSR b_args
        LDI R1, 27
        LDI R2, B_ARGS
        LD R0, [R2]
        MOD R0, R1                      ; colours -13 ... 13
        ST R0, [R2]
        LD R0, [R2+1]
        MOD R0, R1
        ST R0, [R2+1]
        PUSH R7
        LDI R2, B_FONTFG
        LD R0, [R2]
        LDI R2, B_FONTBG
        LD R1, [R2]
        CMP R0, R1
        JNZ sco_go
        JSR loadfont                    ; one colour only: draw the font afresh
        JSR b_fontcolours
sco_go: LDI R5, TILES + 512             ; tile 32's first word
sco_word: LD R3, [R5]
        LDI R4, 0                       ; the new word
        LDI R6, 1                       ; the place of the current pixel
sco_pix: MOV R0, R3
        LDI R2, 27
        MOD R0, R2                      ; the lowest pixel ...
        SUB R3, R0
        DIV R3, R2                      ; ... and the rest
        LDI R2, B_FONTFG
        LD R1, [R2]
        CMP R0, R1
        JZ sco_fg
        LDI R2, B_ARGS
        LD R0, [R2+1]
        JMP sco_put
sco_fg: LDI R2, B_ARGS
        LD R0, [R2]
sco_put: MUL R0, R6
        ADD R4, R0
        LDI R2, 27
        MUL R6, R2                      ; 1, 27, 729, 19683, then 3^12 wraps to 0
        MOV R6, R6
        JNZ sco_pix
        ST R4, [R5]
        INC R5
        LDI R2, TILES + 512 + 1520      ; 95 tiles x 16 words
        CMP R5, R2
        JN sco_word
        LDI R2, B_ARGS
        LD R0, [R2]
        LDI R2, B_FONTFG
        ST R0, [R2]
        LDI R2, B_ARGS
        LD R0, [R2+1]
        LDI R2, B_FONTBG
        ST R0, [R2]
        POP R7
        RET

; ===========================================================================
; Storage (SPEC 10.6.4): the triskette, through the ROM's DISK routines (M13)
; ===========================================================================

; b_fname: R0 = an extension (".TB", ".TRI") or 0. Reads a string expression
; and puts it into FNAME, 0-terminated, with the extension if the name has no
; '.'. (Names the triskette can't take give ?DISK ERROR.)
b_fname: PUSH R0
        JSR b_strexpr
        MOV R1, R0                      ; the name
        LD R2, [R1]
        LDI R0, 13                      ; at most 13 characters (13 is already too many)
        CMP R2, R0
        JLE bfn_len
        LDI R2, 13
bfn_len: PUSH R3
        PUSH R4
        PUSH R5
        LDI R3, FNAME
        LDI R4, 0                       ; 1 once a '.' was seen
        LDI R5, '.'
bfn_copy: MOV R2, R2
        JZ bfn_ext
        INC R1
        LD R0, [R1]
        ST R0, [R3]
        INC R3
        DEC R2
        CMP R0, R5
        JNZ bfn_copy
        LDI R4, 1
        JMP bfn_copy
bfn_ext: LD R1, [SP+3]                  ; the extension
        MOV R4, R4
        JNZ bfn_end
        MOV R1, R1
        JZ bfn_end
bfn_append: LD R0, [R1]
        JZ bfn_end
        ST R0, [R3]
        INC R3
        INC R1
        JMP bfn_append
bfn_end: LDI R0, 0
        ST R0, [R3]
        POP R5
        POP R4
        POP R3
        POP R0
        RET

; b_diskstatus: R0 = a DISK routine's status: 0 goes on, -1 is ?FILE NOT FOUND,
; anything else ?DISK ERROR.
b_diskstatus: MOV R0, R0
        JZ bds_ret
        LDI R1, -1
        CMP R0, R1
        JZ err_notfound
        JMP err_disk
bds_ret: RET

; --- SAVE "NAME": the program as NAME.TB (243 ... its end marker)
st_save: LDI R0, ext_tb
        JSR b_fname
        LDI R2, B_PROGEND
        LD R2, [R2]
        LDI R1, PROGRAM_START
        SUB R2, R1
        INC R2                          ; its length, with the end marker
        LDI R0, FNAME
        JSR disksave
        JMP b_diskstatus

; --- LOAD "NAME": NAME.TB replaces the program; then READY.
st_load: LDI R0, ext_tb
        JSR b_fname
        LDI R0, FNAME
        LDI R1, PROGRAM_START
        JSR diskload
        JSR b_diskstatus
        JSR b_relink                    ; is it a program? if not: NEW ...
        MOV R0, R0
        JZ err_disk                     ; ... and ?DISK ERROR
        JSR b_clearvars
        JMP b_ready

; --- FILES: the names on the triskette, one per line
st_files: LDI R0, TEMP_START
        LDI R1, TEMP_END - TEMP_START
        JSR diskdir
        JSR b_diskstatus
        LDI R5, TEMP_START
sfl_name: JSR b_poll
        LD R0, [R5]
        JZ sfl_ret                      ; the extra 0: the end
        MOV R0, R5
        JSR print
        LDI R0, 10
        JSR putchar
sfl_skip: LD R0, [R5]                   ; past this name and its 0
        INC R5
        MOV R0, R0
        JNZ sfl_skip
        JMP sfl_name
sfl_ret: RET

; --- ERASE "NAME.EXT"
st_erase: LDI R0, 0
        JSR b_fname
        LDI R0, FNAME
        JSR diskdel
        JMP b_diskstatus

; --- BSAVE "NAME", address, length: words as NAME.TRI
st_bsave: LDI R0, ext_tri
        JSR b_fname
        JSR b_comma
        JSR b_numexpr
        PUSH R0
        JSR b_comma
        JSR b_numexpr
        MOV R2, R0
        POP R1
        LDI R0, FNAME
        JSR disksave
        JMP b_diskstatus

; --- BLOAD "NAME" [, address]: NAME.TRI to its own address, or to that one
st_bload: JSR b_bload
        JMP b_afterload

; b_bload: loads the file named after BLOAD / BRUN; R1 = where it went,
; R2 = its length.
b_bload: LDI R0, ext_tri
        JSR b_fname
        LDI R1, -1                      ; negative: its own address
        JSR b_skip
        LDI R2, ','
        CMP R0, R2
        JNZ bbl_go
        INC R7
        JSR b_numexpr
        MOV R1, R0
bbl_go: LDI R0, FNAME
        JSR diskload
        PUSH R1
        PUSH R2
        JSR b_diskstatus
        POP R2
        POP R1
        RET

; b_afterload: R1 = where a block of R2 words went. If it covered the
; program or its variables, they are gone: NEW and READY.
b_afterload: LDI R0, B_VAREND
        LD R0, [R0]
        CMP R1, R0
        JGE bal_ret                     ; it starts after the variables
        ADD R1, R2
        LDI R0, PROGRAM_START
        CMP R1, R0
        JLE bal_ret                     ; it ends before the program
        JSR b_new
        JMP b_ready
bal_ret: RET

; --- BRUN "NAME": BLOAD, then call it (SYS). The games run like this.
st_brun: JSR b_bload
        PUSH R1
        PUSH R2
        MOV R0, R1
        JSR b_call
        POP R2
        POP R1
        JMP b_afterload

; ===========================================================================
; The modem (SPEC 5.2, 10.6.5; M17): MDIAL, MHANGUP, MSEND, MSTATUS, MRECV$.
; They only drive the modem's registers; a program polls MSTATUS itself.
; DIAL (the terminal program, M19) has its token already, but no routine yet.
; ===========================================================================

; --- MDIAL "number": starts a call (the first 13 characters of the string)
st_mdial: LDI R0, 0
        JSR b_fname                     ; the number, 0-terminated, into FNAME
        LDI R2, IO_BASE
        LDI R0, FNAME
        ST R0, [R2+MDM_ADDR]
        LDI R0, 1                       ; DIAL
        ST R0, [R2+MDM_CMD]
        RET

; --- MHANGUP
st_mhangup: LDI R2, IO_BASE
        LDI R0, 2                       ; HANG UP
        ST R0, [R2+MDM_CMD]
        RET

; --- MSEND s$: sends the characters. While the send buffer is full it waits
; a frame at a time (Esc still stops the program). Not connected: the modem
; ignores them, and its buffer never fills.
st_msend: JSR b_strexpr
        PUSH R3
        PUSH R4
        LD R3, [R0]                     ; R3 = characters left
        MOV R4, R0                      ; R4 = the last one sent
sms_loop: MOV R3, R3
        JZ sms_end
        LDI R2, IO_BASE
        LD R0, [R2+MDM_TXFREE]
        JP sms_send                     ; room for one more
        WAIT                            ; full: a frame carries two away
        JSR b_poll
        JMP sms_loop
sms_send: INC R4
        LD R0, [R4]
        ST R0, [R2+MDM_TX]
        DEC R3
        JMP sms_loop
sms_end: POP R4
        POP R3
        RET

; --- DIAL "number" (M19): loads TERM.TRI from the triskette to its own
; address, puts the number into TERM's number slot (2 words in: TERM starts
; with a 2-word JMP, then 17 words for the number) and calls it, like BRUN.
; TERM comes back with RET, or through BASIC_WARM if a transfer used the
; program area. No TERM.TRI on the triskette: ?FILE NOT FOUND ERROR.
st_dial: JSR b_strexpr                  ; R0 = the number's SLOT
        PUSH R0
        LDI R1, term_file               ; "TERM.TRI" into FNAME (RAM, for the drive)
        LDI R2, FNAME
sdl_name: LD R0, [R1]
        ST R0, [R2]
        INC R1
        INC R2
        MOV R0, R0
        JNZ sdl_name
        LDI R0, FNAME
        LDI R1, -1                      ; to its own address
        JSR diskload
        PUSH R1
        PUSH R2
        JSR b_diskstatus
        POP R2
        POP R1
        POP R0                          ; the number's SLOT
        PUSH R3
        PUSH R4
        LD R3, [R0]                     ; R3 = its length, at most 16
        LDI R4, 16
        CMP R3, R4
        JLE sdl_len
        MOV R3, R4
sdl_len: MOV R4, R1
        ADDI R4, 2                      ; R4 = TERM's number slot
sdl_copy: MOV R3, R3
        JZ sdl_end
        INC R0
        PUSH R1
        LD R1, [R0]
        ST R1, [R4]
        POP R1
        INC R4
        DEC R3
        JMP sdl_copy
sdl_end: LDI R0, 0
        ST R0, [R4]
        POP R4
        POP R3
        PUSH R1                         ; and run it (as BRUN does)
        PUSH R2
        MOV R0, R1
        JSR b_call
        POP R2
        POP R1
        JMP b_afterload

term_file:  .str "TERM.TRI"

; --- MSTATUS: the modem's status (SPEC 5.2)
fn_mstatus: LDI R2, IO_BASE
        LD R0, [R2+MDM_STATUS]
        JMP b_isnum

; --- MRECV$: everything received so far, up to 80 characters
fn_mrecv: JSR b_tmpnew
        PUSH R3
        MOV R3, R0                      ; R3 = the string
        MOV R1, R0                      ; R1 = where the last character went
        LDI R2, IO_BASE
fmr_loop: MOV R0, R1
        SUB R0, R3
        ADDI R0, -80
        JZ fmr_end                      ; 80 characters: the string is full
        LD R0, [R2+MDM_RXCOUNT]
        JZ fmr_end
        LD R0, [R2+MDM_RX]              ; reading takes it from the modem
        INC R1
        ST R0, [R1]
        JMP fmr_loop
fmr_end: SUB R1, R3
        ST R1, [R3]                     ; the length
        MOV R0, R3
        POP R3
        JMP b_isstr

; ===========================================================================
; Tables and texts
; ===========================================================================

; sttab: the routine for each keyword that starts a statement (token -1 is
; the first entry); 0 = not a statement (CONT is not one, D-051).
sttab:  .word st_print, st_input, st_ask, st_let, st_goto, st_gosub, st_return
        .word st_for, 0, 0, st_next, st_if, 0, 0, 0, st_rem, st_end, st_stop
        .word st_dim, st_cls, st_locate, st_list, st_run, st_new, st_mon, 0
        .fill 7, 0                      ; AND ... UNKNOWN (-27 ... -33)
        .word st_tile, st_deftile, st_sprite, st_sound, st_border, st_scroll
        .word st_wait, st_color, st_poke, st_sys, st_save, st_load, st_files
        .word st_erase, st_bsave, st_bload, st_brun
        .fill 18, 0                     ; the functions (-51 ... -68)
        .word st_dial, st_mdial, st_mhangup, st_msend ; DIAL (M19), MDIAL ... (-69 ... -72)
        .fill 2, 0                      ; MSTATUS, MRECV$ (-73, -74)

; fntab: the routine for each function, from ABS (-51) to TERN$ (-68), then
; the modem's (M17): every token from -51 down is looked up here, so the four
; statements in between (-69 ... -72) are errors when used as values.
fntab:  .word fn_abs, fn_sgn, fn_rnd, fn_peek, fn_joyx, fn_joyy, fn_btn
        .word fn_inkey, fn_frame, fn_len, fn_left, fn_right, fn_mid, fn_chr
        .word fn_asc, fn_str, fn_val, fn_tern
        .word err_syntax, err_syntax, err_syntax, err_syntax
        .word fn_mstatus, fn_mrecv

; kwtab: every keyword, in token order (-1, -2, ...). The whole language is
; here from the start, so saved programs keep their tokens when M15 adds the
; statements and functions behind them.
kwtab:  .word kw_print, kw_input, kw_ask, kw_let, kw_goto, kw_gosub, kw_return
        .word kw_for, kw_to, kw_step, kw_next, kw_if, kw_then, kw_maybe, kw_else
        .word kw_rem, kw_end, kw_stop, kw_dim, kw_cls, kw_locate, kw_list, kw_run
        .word kw_new, kw_mon, kw_cont, kw_and, kw_or, kw_not, kw_mod, kw_true
        .word kw_false, kw_unknown, kw_tile, kw_deftile, kw_sprite, kw_sound
        .word kw_border, kw_scroll, kw_wait, kw_color, kw_poke, kw_sys, kw_save
        .word kw_load, kw_files, kw_erase, kw_bsave, kw_bload, kw_brun, kw_abs
        .word kw_sgn, kw_rnd, kw_peek, kw_joyx, kw_joyy, kw_btn, kw_inkey
        .word kw_frame, kw_len, kw_left, kw_right, kw_mid, kw_chr, kw_asc
        .word kw_str, kw_val, kw_tern
        .word kw_dial, kw_mdial, kw_mhangup, kw_msend, kw_mstatus, kw_mrecv
        .word 0
kw_print:   .str "PRINT"
kw_input:   .str "INPUT"
kw_ask:     .str "ASK"
kw_let:     .str "LET"
kw_goto:    .str "GOTO"
kw_gosub:   .str "GOSUB"
kw_return:  .str "RETURN"
kw_for:     .str "FOR"
kw_to:      .str "TO"
kw_step:    .str "STEP"
kw_next:    .str "NEXT"
kw_if:      .str "IF"
kw_then:    .str "THEN"
kw_maybe:   .str "MAYBE"
kw_else:    .str "ELSE"
kw_rem:     .str "REM"
kw_end:     .str "END"
kw_stop:    .str "STOP"
kw_dim:     .str "DIM"
kw_cls:     .str "CLS"
kw_locate:  .str "LOCATE"
kw_list:    .str "LIST"
kw_run:     .str "RUN"
kw_new:     .str "NEW"
kw_mon:     .str "MON"
kw_cont:    .str "CONT"
kw_and:     .str "AND"
kw_or:      .str "OR"
kw_not:     .str "NOT"
kw_mod:     .str "MOD"
kw_true:    .str "TRUE"
kw_false:   .str "FALSE"
kw_unknown: .str "UNKNOWN"
kw_tile:    .str "TILE"
kw_deftile: .str "DEFTILE"
kw_sprite:  .str "SPRITE"
kw_sound:   .str "SOUND"
kw_border:  .str "BORDER"
kw_scroll:  .str "SCROLL"
kw_wait:    .str "WAIT"
kw_color:   .str "COLOR"
kw_poke:    .str "POKE"
kw_sys:     .str "SYS"
kw_save:    .str "SAVE"
kw_load:    .str "LOAD"
kw_files:   .str "FILES"
kw_erase:   .str "ERASE"
kw_bsave:   .str "BSAVE"
kw_bload:   .str "BLOAD"
kw_brun:    .str "BRUN"
kw_abs:     .str "ABS"
kw_sgn:     .str "SGN"
kw_rnd:     .str "RND"
kw_peek:    .str "PEEK"
kw_joyx:    .str "JOYX"
kw_joyy:    .str "JOYY"
kw_btn:     .str "BTN"
kw_inkey:   .str "INKEY"
kw_frame:   .str "FRAME"
kw_len:     .str "LEN"
kw_left:    .str "LEFT$"
kw_right:   .str "RIGHT$"
kw_mid:     .str "MID$"
kw_chr:     .str "CHR$"
kw_asc:     .str "ASC"
kw_str:     .str "STR$"
kw_val:     .str "VAL"
kw_tern:    .str "TERN$"
kw_dial:    .str "DIAL"
kw_mdial:   .str "MDIAL"
kw_mhangup: .str "MHANGUP"
kw_msend:   .str "MSEND"
kw_mstatus: .str "MSTATUS"
kw_mrecv:   .str "MRECV$"

; errtab: the messages of SPEC 10.7, by error number (1 = SYNTAX)
errtab: .word e_syntax, e_undef, e_return, e_next, e_memory, e_div0, e_overflow
        .word e_type, e_subscript, e_toolong, e_notfound, e_disk
e_syntax:    .str "SYNTAX"
e_undef:     .str "UNDEFINED LINE"
e_return:    .str "RETURN WITHOUT GOSUB"
e_next:      .str "NEXT WITHOUT FOR"
e_memory:    .str "OUT OF MEMORY"
e_div0:      .str "DIVISION BY ZERO"
e_overflow:  .str "OVERFLOW"
e_type:      .str "TYPE MISMATCH"
e_subscript: .str "BAD SUBSCRIPT"
e_toolong:   .str "STRING TOO LONG"
e_notfound:  .str "FILE NOT FOUND"
e_disk:      .str "DISK"

msg_tribasic: .str "TRIBASIC V1.0\n"
msg_error:  .str " ERROR"
msg_in:     .str " IN "
msg_break:  .str "BREAK"
msg_qmark:  .str "? "
msg_redo:   .str "?REDO\n"
msg_yn:     .str " (Y/N/?) "
ext_tb:     .str ".TB"
ext_tri:    .str ".TRI"
