10 REM DIAL THE ECHO BOARD
20 MDIAL "1-11-11"
30 WAIT 1: IF MSTATUS = 1 THEN GOTO 30
40 PRINT "STATUS"; MSTATUS
50 MSEND "TRIT"
60 WAIT 20
70 A$ = MRECV$
80 PRINT LEFT$(A$, 10); LEN(A$); ASC(MID$(A$, 11, 1))
90 PRINT RIGHT$(A$, 4)
100 MSEND CHR$(4)
110 WAIT 20
120 PRINT LEFT$(MRECV$, 3); MSTATUS
130 MHANGUP
140 PRINT MSTATUS; LEN(MRECV$)
