10 REM ZMEYKA - A SMALL SNAKE IN TRIBASIC. ARROWS STEER.
20 CLS: DIM X(400), Y(400)
30 FOR R = 0 TO 7
40 DEFTILE 1, R, -7, -7, -7, -7, -7, -7, -7, -7
50 DEFTILE 2, R, 5, 5, 5, 5, 5, 5, 5, 5
60 NEXT
70 FOR I = 0 TO 26: TILE I, 1, 35: TILE I, 17, 35: NEXT
80 FOR I = 1 TO 17: TILE 0, I, 35: TILE 26, I, 35: NEXT
90 SC = 0: DX = 1: DY = 0
100 FOR I = 0 TO 2: X(I) = 5 + I: Y(I) = 9: TILE 5 + I, 9, 1: NEXT
110 HD = 2: TL = 0
120 GOSUB 400
130 LOCATE 0, 0: PRINT "ZMEYKA  SCORE "; SC
140 WAIT 6
150 J = JOYX: K = JOYY
160 IF J <> 0 AND DX = 0 THEN DX = J: DY = 0
170 IF K <> 0 AND DY = 0 THEN DY = K: DX = 0
180 NX = X(HD) + DX: NY = Y(HD) + DY
190 C = PEEK(44000 + NY * 27 + NX)
200 IF C = 35 OR C = 1 THEN 300
210 HD = HD + 1: IF HD > 400 THEN HD = 0
220 X(HD) = NX: Y(HD) = NY: TILE NX, NY, 1
230 IF C = 2 THEN SC = SC + 1: SOUND 1, 880, 9, 1: GOSUB 400: GOTO 130
240 SOUND 1, 0, 0, 0
250 TILE X(TL), Y(TL), 32: TL = TL + 1: IF TL > 400 THEN TL = 0
260 GOTO 140
300 SOUND 1, 110, 13, -1: LOCATE 9, 9: PRINT "GAME OVER": WAIT 30
310 SOUND 1, 0, 0, 0: CLS: PRINT "ZMEYKA SCORE: "; SC
320 END
400 FX = RND(25): FY = RND(15) + 1
410 IF PEEK(44000 + FY * 27 + FX) <> 32 THEN 400
420 TILE FX, FY, 2: RETURN
