10 REM GUESS - THE HINTS COME FROM THE COMPARE OPERATOR <=>
20 N = RND(100): T = 0
30 PRINT "I AM THINKING OF A NUMBER"
40 PRINT "FROM 1 TO 100."
50 INPUT "YOUR GUESS"; G
60 T = T + 1
70 C = G <=> N
80 IF C THEN PRINT "TOO HIGH" MAYBE 100 ELSE PRINT "TOO LOW"
90 GOTO 50
100 PRINT "RIGHT IN "; T; " TRIES!"
