10 REM AUTOCALL: A MODEM BOT
20 REM DIALS, SAYS HELLO, PRINTS
30 REM THE ANSWER AND HANGS UP.
40 N$ = "1-11-11"
50 PRINT "DIALING "; N$
60 MDIAL N$
70 WAIT 1: IF MSTATUS = 1 THEN GOTO 70
80 S = MSTATUS
90 IF S <> 2 THEN GOTO 200
100 PRINT "CONNECT 1200"
110 MSEND "HELLO FROM TRIADA"
120 WAIT 30
130 R$ = MRECV$: GOSUB 300
140 MHANGUP
150 PRINT "HUNG UP."
160 END
200 IF S = -2 THEN PRINT "BUSY"
210 IF S = -3 THEN PRINT "NO SUCH NUMBER"
220 IF S = -4 THEN PRINT "TRIADA-NET IS OFFLINE"
230 IF S = -1 THEN PRINT "NO CARRIER"
240 END
300 REM PRINT R$: 13 IS A NEW LINE
310 FOR I = 1 TO LEN(R$)
320 C = ASC(MID$(R$, I, 1))
330 IF C = 13 THEN PRINT
340 IF C >= 32 THEN PRINT CHR$(C);
350 NEXT I
360 PRINT
370 RETURN
