10 REM TERNCLOCK - THE TIME IN BALANCED TERNARY
20 CLS: PRINT "TERNCLOCK"
30 FOR R = 0 TO 7
40 DEFTILE 1, R, -11, -11, -11, -11, -11, -11, -11, -11
50 DEFTILE 2, R, 0, 0, 0, 0, 0, 0, 0, 0
60 DEFTILE 3, R, 5, 5, 5, 5, 5, 5, 5, 5
70 NEXT
80 H = 12: M = 0: S = 0
90 LOCATE 0, 2: PRINT "BLUE -1   GREY 0   RED +1"
100 LOCATE 0, 4: PRINT "HOURS"
110 LOCATE 0, 6: PRINT "MINUTES"
120 LOCATE 0, 8: PRINT "SECONDS"
130 LOCATE 0, 11: PRINT "PRESS A KEY TO STOP"
140 V = H: Y = 4: GOSUB 500
150 V = M: Y = 6: GOSUB 500
160 V = S: Y = 8: GOSUB 500
170 WAIT 60: IF INKEY THEN 900
180 S = S + 1: IF S = 60 THEN S = 0: M = M + 1
190 IF M = 60 THEN M = 0: H = H + 1
200 IF H = 24 THEN H = 0
210 GOTO 140
500 REM V AS 5 TRITS (THE LOWEST IN COLUMN 14), THEN AS TEXT
510 W = V
520 FOR C = 14 TO 10 STEP -1
530 T = V MOD 3: V = (V - T) / 3
540 TILE C, Y, T + 2
550 NEXT
560 LOCATE 16, Y: PRINT TERN$(W); "     "
570 RETURN
900 LOCATE 0, 13: PRINT "STOPPED AT "; H; ":"; M; ":"; S
