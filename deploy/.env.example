# Copy this file to .env and fill it in (M18). Never commit .env: it holds the admin token.

# The domain name pointing at this server (an A record at your DNS provider).
TRIADA_NET_DOMAIN=net.example.org

# The web pages allowed to open a WebSocket: the GitHub Pages site of the web version.
TRIADA_NET_ORIGINS=https://droidek314.github.io

# The secret for the admin page and API, at least 16 characters. Make it long and random,
# for example the output of:  openssl rand -hex 24
TRIADA_NET_ADMIN_TOKEN=change-me-to-a-long-random-secret

# Optional limits (these are the defaults).
# TRIADA_NET_CONNECTIONS_PER_IP=4
# TRIADA_NET_CONNECTIONS_PER_MINUTE=20

# Optional: a folder of your own .board files, mounted into the container.
# TRIADA_NET_BOARDS=/boards
